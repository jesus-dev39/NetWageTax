---
import '@fontsource-variable/public-sans';
import '../styles/global.css';
import Logo from '../components/Logo';
import { ADSENSE_CLIENT, formatLongDate, GOOGLE_SITE_VERIFICATION, SITE_TAX_YEAR } from '../lib/site';
import { STATE_TAX_LAST_UPDATED } from '../lib/state-tax-data';

interface Props {
  title: string;
  description: string;
  /** Open Graph type: "website" for the home page, "article" for tool pages. */
  ogType?: 'website' | 'article';
}

const { title, description, ogType = 'website' } = Astro.props;

const SITE_NAME = 'NetWageTax';
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
// Canonical/OG URLs require `site` in astro.config.mjs.
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

// Header bar (md+) and the mobile drawer. `section` marks the link active on nested pages.
const navLinks = [
  { href: '/tools/paycheck-calculator/', label: 'Paycheck', section: '/tools/paycheck-calculator' },
  { href: '/tools/obbba-tax-calculator/', label: 'Tips & overtime', section: '/tools/obbba-tax-calculator' },
  { href: '/state-taxes/', label: 'State taxes', section: '/state-taxes' },
  { href: '/guides/w2-box-12-guide/', label: 'W-2 codes', section: '/guides' },
  { href: '/about/', label: 'About', section: '/about' },
];

// The drawer adds the two links that live only in the footer on desktop.
const mobileLinks = [
  ...navLinks,
  { href: '/methodology/', label: 'How we calculate', section: '/methodology' },
  { href: '/contact/', label: 'Contact', section: '/contact' },
];

const footerGroups = [
  {
    heading: 'Tools',
    links: [
      { href: '/tools/paycheck-calculator/', label: 'Paycheck calculator' },
      { href: '/tools/obbba-tax-calculator/', label: 'Tips and overtime calculator' },
      { href: '/state-taxes/', label: 'Income tax by state' },
      { href: '/guides/w2-box-12-guide/', label: 'W-2 Box 12 codes' },
    ],
  },
  {
    heading: 'NetWageTax',
    links: [
      { href: '/about/', label: 'About' },
      { href: '/methodology/', label: 'How we calculate' },
      { href: '/contact/', label: 'Contact' },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { href: '/privacy/', label: 'Privacy policy' },
      { href: '/terms/', label: 'Terms of use' },
      { href: '/disclaimer/', label: 'Disclaimer' },
    ],
  },
];

// Status strip: when the rules behind the estimates were last reviewed.
const rulesCheckedLabel = formatLongDate(STATE_TAX_LAST_UPDATED);

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const matches = (section: string) => currentPath === section || currentPath.startsWith(`${section}/`);
// Only the most specific matching section is active.
const activeSection = mobileLinks
  .map((l) => l.section)
  .filter(matches)
  .sort((a, b) => b.length - a.length)[0];
const isActive = (section: string) => section === activeSection;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Theme: runs before first paint to avoid a flash of the wrong theme. -->
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>

    <!-- Google Search Console verification -->
    <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />

    <!-- Google AdSense: account verification + loader (also enables Auto ads if turned on in the AdSense dashboard) -->
    <meta name="google-adsense-account" content={ADSENSE_CLIENT} />
    <script
      is:inline
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
      crossorigin="anonymous"
    ></script>

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-page font-sans text-base/[1.55] text-ink antialiased md:text-[17px]/[1.55]">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-control focus:bg-page focus:px-4 focus:py-2 focus:font-semibold focus:text-ink"
    >
      Skip to main content
    </a>

    <header id="site-header" class="group/header sticky top-0 z-40 border-b border-line bg-page">
      <div class="container-page flex h-16 items-center gap-6">
        <a href="/" class="shrink-0" aria-label="NetWageTax home">
          <Logo />
        </a>

        <nav aria-label="Main" class="ml-auto hidden h-full md:block">
          <ul class="flex h-full items-stretch gap-5 lg:gap-7">
            {
              navLinks.map(({ href, label, section }) => (
                <li class="flex">
                  <a
                    href={href}
                    aria-current={isActive(section) ? 'page' : undefined}
                    class:list={[
                      'inline-flex items-center whitespace-nowrap border-y-[3px] border-t-transparent text-ink hover:underline hover:underline-offset-4',
                      isActive(section) ? 'border-b-green font-semibold' : 'border-b-transparent',
                    ]}
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="ml-auto flex items-center gap-1 md:ml-0">
          <button
            type="button"
            id="theme-toggle"
            aria-label="Dark theme"
            aria-pressed="false"
            class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-control text-ink transition-colors hover:bg-surface"
          >
            <!-- Moon (shown in light mode) -->
            <svg class="h-5 w-5 dark:hidden" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M16.5 12.2A7 7 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7Z" stroke-linejoin="round" />
            </svg>
            <!-- Sun (shown in dark mode) -->
            <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="10" cy="10" r="3.5" />
              <path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6 16 16M4 16l1.4-1.4M14.6 5.4 16 4" stroke-linecap="round" />
            </svg>
          </button>

          <button
            type="button"
            id="menu-toggle"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="-mr-2 inline-flex h-11 min-w-16 items-center justify-center rounded-control px-2 font-semibold text-ink transition-colors hover:bg-surface md:hidden"
          >
            <span class="group-data-[menu-open]/header:hidden">Menu</span>
            <span class="hidden group-data-[menu-open]/header:inline">Close</span>
          </button>
        </div>
      </div>

      <!-- Mobile drawer: overlays the page below the header; inert (unfocusable, hidden from AT) while closed. -->
      <div
        id="mobile-menu"
        inert
        class="absolute inset-x-0 top-full grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-150 ease-out group-data-[menu-open]/header:grid-rows-[1fr] group-data-[menu-open]/header:opacity-100 motion-reduce:transition-none md:hidden"
      >
        <div class="overflow-hidden">
          <nav aria-label="Mobile" class="border-b border-line bg-page shadow-[0_8px_24px_rgb(26_31_36/0.12)]">
            <ul class="container-page pb-2">
              {
                mobileLinks.map(({ href, label, section }) => (
                  <li class="border-t border-line first:border-t-0">
                    <a
                      href={href}
                      aria-current={isActive(section) ? 'page' : undefined}
                      class:list={[
                        'block border-l-4 py-3 pl-3 text-[17px] text-ink',
                        isActive(section) ? 'border-green font-semibold' : 'border-transparent',
                      ]}
                    >
                      {label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <!-- Status strip (docs/DESIGN.md §6): the tax year and when the rules were last reviewed. -->
    <div class="border-b border-line bg-surface text-sm text-ink-2 sm:text-[15px]">
      <p class="container-page py-2.5">
        <strong class="font-semibold text-ink">Tax year {SITE_TAX_YEAR}.</strong> Federal, FICA, and state rules last
        checked <time datetime={STATE_TAX_LAST_UPDATED}>{rulesCheckedLabel}</time>.{' '}
        <a href="/methodology/" class="text-link underline underline-offset-[3px] hover:decoration-2">How we calculate</a>
      </p>
    </div>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-line bg-surface">
      <div class="container-page py-12">
        <div class="grid gap-10 md:grid-cols-[minmax(0,1.3fr)_repeat(3,minmax(0,1fr))] md:gap-8">
          <div>
            <Logo />
            <p class="mt-3 max-w-xs text-[15px] text-ink-2">
              Free calculators that help American workers understand their paychecks and taxes.
            </p>
          </div>
          {
            footerGroups.map(({ heading, links }) => (
              <nav aria-label={heading === 'NetWageTax' ? 'About NetWageTax' : heading}>
                <h2 class="text-[15px] font-bold text-ink">{heading}</h2>
                <ul class="mt-3 space-y-2 text-[15px]">
                  {links.map(({ href, label }) => (
                    <li>
                      <a href={href} class="text-link underline underline-offset-[3px] hover:decoration-2">
                        {label}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            ))
          }
        </div>
        <div class="mt-10 border-t border-line pt-6 text-sm text-ink-2">
          <p class="max-w-3xl">
            NetWageTax is an independent calculation tool and is not affiliated with the IRS or any government agency.
            Results are estimates for educational purposes and do not constitute tax, legal, or financial advice.
          </p>
          <p class="mt-3">&copy; 2026 NetWageTax</p>
        </div>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const toggle = document.getElementById('theme-toggle');
      const media = matchMedia('(prefers-color-scheme: dark)');

      function apply(dark: boolean) {
        root.classList.toggle('dark', dark);
        toggle?.setAttribute('aria-pressed', String(dark));
      }

      function storedTheme() {
        try {
          return localStorage.getItem('theme');
        } catch {
          return null;
        }
      }

      apply(root.classList.contains('dark'));

      toggle?.addEventListener('click', () => {
        const dark = !root.classList.contains('dark');
        apply(dark);
        try {
          localStorage.setItem('theme', dark ? 'dark' : 'light');
        } catch {}
      });

      // Mobile menu: data-menu-open on the header drives the icons and the slide-down in CSS.
      const header = document.getElementById('site-header');
      const menuToggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');

      const menuOpen = () => header?.hasAttribute('data-menu-open') ?? false;

      function setMenu(open: boolean, restoreFocus = false) {
        if (!header || !menuToggle || !menu) return;
        header.toggleAttribute('data-menu-open', open);
        menuToggle.setAttribute('aria-expanded', String(open));
        menu.inert = !open;
        if (!open && restoreFocus) menuToggle.focus();
      }

      menuToggle?.addEventListener('click', () => setMenu(!menuOpen()));
      // Any link in the drawer closes it (also covers same-page hash links like /#calculators).
      menu?.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a')) setMenu(false);
      });
      // A click or tap outside the header closes it.
      document.addEventListener('pointerdown', (e) => {
        if (menuOpen() && !header?.contains(e.target as Node)) setMenu(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menuOpen()) setMenu(false, true);
      });
      // Past the md breakpoint the button disappears; don't leave the drawer open behind it.
      matchMedia('(min-width: 48rem)').addEventListener('change', (e) => {
        if (e.matches) setMenu(false);
      });

      // Follow the OS setting until the user picks a theme explicitly.
      media.addEventListener('change', (e) => {
        if (!storedTheme()) apply(e.matches);
      });
    </script>
  </body>
</html>
