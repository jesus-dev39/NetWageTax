---
import '@fontsource-variable/public-sans';
import '../styles/global.css';
import Logo from '../components/Logo';
import { ADSENSE_CLIENT, GOOGLE_SITE_VERIFICATION } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Open Graph type: "website" for the home page, "article" for tool pages. */
  ogType?: 'website' | 'article';
}

const { title, description, ogType = 'website' } = Astro.props;

const SITE_NAME = 'NetWageTax';
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
// Canonical/OG URLs require `site` in astro.config.mjs.
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

// Desktop (md+) bar. `section` marks the link active on nested pages.
// `hideBelow` drops About between md and lg (it stays in the footer) so the bar fits on one line.
const navLinks = [
  { href: '/#calculators', label: 'Calculators', section: '/tools', hideBelow: '' },
  { href: '/tools/paycheck-calculator/', label: 'Paycheck Calculator', section: '/tools/paycheck-calculator', hideBelow: '' },
  { href: '/state-taxes/', label: 'State Taxes', section: '/state-taxes', hideBelow: '' },
  { href: '/guides/w2-box-12-guide/', label: 'W-2 Guide', section: '/guides', hideBelow: '' },
  { href: '/about/', label: 'About', section: '/about', hideBelow: 'hidden lg:list-item' },
  { href: '/contact/', label: 'Contact', section: '/contact', hideBelow: 'hidden lg:list-item' },
];

// Mobile drawer (below md).
const mobileLinks = [
  { href: '/#calculators', label: 'All Calculators', hint: 'Paycheck, tips & overtime', section: '/tools' },
  { href: '/tools/paycheck-calculator/', label: 'Paycheck Calculator', hint: 'Hourly & salary take-home pay', section: '/tools/paycheck-calculator' },
  { href: '/state-taxes/', label: '50-State Tax Directory & Map', hint: 'Income tax rates for every state', section: '/state-taxes' },
  { href: '/guides/w2-box-12-guide/', label: 'W-2 Box 12 Reference Guide', hint: 'Codes TA, TP, TT, D, DD, W and more', section: '/guides' },
  { href: '/about/', label: 'About NetWageTax', hint: 'Who we are and how we work', section: '/about' },
  { href: '/contact/', label: 'Contact Us', hint: 'Report an error or suggest a calculator', section: '/contact' },
  { href: '/disclaimer/', label: 'Tax Disclaimer', hint: 'Estimates, not tax advice', section: '/disclaimer' },
];

const footerLinks = [
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
  { href: '/tools/obbba-tax-calculator/', label: 'Tips & Overtime Calculator' },
  { href: '/tools/paycheck-calculator/', label: 'Paycheck Calculator' },
  { href: '/state-taxes/', label: 'State Income Tax Map' },
  { href: '/guides/w2-box-12-guide/', label: 'W-2 Box 12 Guide' },
  { href: '/privacy/', label: 'Privacy Policy' },
  { href: '/terms/', label: 'Terms of Use' },
  { href: '/disclaimer/', label: 'Disclaimer' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const matches = (section: string) => currentPath === section || currentPath.startsWith(`${section}/`);
// Only the most specific matching section is active (e.g. /tools/paycheck-calculator, not also /tools).
const activeSection = [...navLinks, ...mobileLinks]
  .map((l) => l.section)
  .filter(matches)
  .sort((a, b) => b.length - a.length)[0];
const isActive = (section: string) => section === activeSection;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Theme: runs before first paint to avoid a flash of the wrong theme. -->
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>

    <!-- Google Search Console verification -->
    <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />

    <!-- Google AdSense: account verification + loader (also enables Auto ads if turned on in the AdSense dashboard) -->
    <meta name="google-adsense-account" content={ADSENSE_CLIENT} />
    <script
      is:inline
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
      crossorigin="anonymous"
    ></script>

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 dark:bg-slate-950 font-sans text-slate-900 dark:text-slate-100 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:shadow"
    >
      Skip to main content
    </a>

    <header
      id="site-header"
      class="group/header sticky top-0 z-40 border-b border-slate-200 before:absolute before:inset-0 before:-z-10 before:bg-white/90 before:backdrop-blur before:content-[''] dark:border-slate-800 dark:before:bg-slate-950/90"
    >
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-4 sm:px-6">
        <a href="/" class="shrink-0 rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600/40" aria-label="NetWageTax home">
          <Logo />
        </a>

        <nav aria-label="Main" class="ml-auto hidden md:block">
          <ul class="flex items-center gap-0.5 text-sm font-medium lg:gap-2">
            {
              navLinks.map(({ href, label, section, hideBelow }) => (
                <li class={hideBelow}>
                  <a
                    href={href}
                    aria-current={isActive(section) ? 'page' : undefined}
                    class:list={[
                      'whitespace-nowrap rounded-md px-3 py-2 transition hover:bg-slate-100 hover:text-slate-900 dark:hover:bg-slate-800 dark:hover:text-white',
                      isActive(section) ? 'text-emerald-700 dark:text-emerald-400' : 'text-slate-600 dark:text-slate-400',
                    ]}
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="ml-auto flex items-center gap-1 md:-ml-3">
          <button
            type="button"
            id="theme-toggle"
            aria-label="Dark theme"
            aria-pressed="false"
            class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-md text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600/40 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white"
          >
            <!-- Moon (shown in light mode) -->
            <svg class="h-5 w-5 dark:hidden" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M16.5 12.2A7 7 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7Z" stroke-linejoin="round" />
            </svg>
            <!-- Sun (shown in dark mode) -->
            <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <circle cx="10" cy="10" r="3.5" />
              <path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6 16 16M4 16l1.4-1.4M14.6 5.4 16 4" stroke-linecap="round" />
            </svg>
          </button>

          <button
            type="button"
            id="menu-toggle"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="-mr-2 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-md text-slate-700 transition hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600/40 md:hidden dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white"
          >
            <!-- Hamburger (closed) -->
            <svg class="h-6 w-6 group-data-[menu-open]/header:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            <!-- X (open) -->
            <svg class="hidden h-6 w-6 group-data-[menu-open]/header:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="m6 6 12 12M18 6 6 18" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile drawer: overlays the page below the header; inert (unfocusable, hidden from AT) while closed.
           The header's own blur lives on ::before so it doesn't block this drawer's backdrop-blur. -->
      <div
        id="mobile-menu"
        inert
        class="absolute inset-x-0 top-full grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-200 ease-out group-data-[menu-open]/header:grid-rows-[1fr] group-data-[menu-open]/header:opacity-100 motion-reduce:transition-none md:hidden"
      >
        <div class="overflow-hidden">
          <nav
            aria-label="Mobile"
            class="border-b border-slate-200 bg-white/95 shadow-lg backdrop-blur dark:border-slate-800 dark:bg-slate-900/95"
          >
            <ul class="mx-auto max-w-6xl px-2 py-2 sm:px-4">
              {
                mobileLinks.map(({ href, label, hint, section }) => (
                  <li>
                    <a
                      href={href}
                      aria-current={isActive(section) ? 'page' : undefined}
                      class:list={[
                        'flex items-center justify-between gap-4 rounded-lg px-3 py-3 transition hover:bg-slate-100 dark:hover:bg-slate-800',
                        isActive(section) ? 'bg-emerald-50 dark:bg-emerald-500/10' : '',
                      ]}
                    >
                      <span>
                        <span
                          class:list={[
                            'block font-medium',
                            isActive(section) ? 'text-emerald-700 dark:text-emerald-400' : 'text-slate-900 dark:text-slate-100',
                          ]}
                        >
                          {label}
                        </span>
                        <span class="block text-sm text-slate-500 dark:text-slate-400">{hint}</span>
                      </span>
                      <span class="text-slate-400" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
        <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
          <div class="max-w-md">
            <Logo />
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
              Free, independent calculators that help American workers understand their paychecks and taxes.
            </p>
          </div>
          <nav aria-label="Footer">
            <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
              {
                footerLinks.map(({ href, label }) => (
                  <li>
                    <a href={href} class="text-slate-600 dark:text-slate-400 transition hover:text-navy-700 dark:hover:text-navy-300">
                      {label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
        <div class="mt-8 border-t border-slate-200 dark:border-slate-800 pt-6 text-sm text-slate-500 dark:text-slate-400">
          <p>
            NetWageTax is an independent calculation tool and is not affiliated with the IRS or any government agency.
            Results are estimates for educational purposes and do not constitute tax, legal, or financial advice.
          </p>
          <p class="mt-3">&copy; 2026 NetWageTax. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const toggle = document.getElementById('theme-toggle');
      const media = matchMedia('(prefers-color-scheme: dark)');

      function apply(dark: boolean) {
        root.classList.toggle('dark', dark);
        toggle?.setAttribute('aria-pressed', String(dark));
      }

      function storedTheme() {
        try {
          return localStorage.getItem('theme');
        } catch {
          return null;
        }
      }

      apply(root.classList.contains('dark'));

      toggle?.addEventListener('click', () => {
        const dark = !root.classList.contains('dark');
        apply(dark);
        try {
          localStorage.setItem('theme', dark ? 'dark' : 'light');
        } catch {}
      });

      // Mobile menu: data-menu-open on the header drives the icons and the slide-down in CSS.
      const header = document.getElementById('site-header');
      const menuToggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');

      const menuOpen = () => header?.hasAttribute('data-menu-open') ?? false;

      function setMenu(open: boolean, restoreFocus = false) {
        if (!header || !menuToggle || !menu) return;
        header.toggleAttribute('data-menu-open', open);
        menuToggle.setAttribute('aria-expanded', String(open));
        menuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        menu.inert = !open;
        if (!open && restoreFocus) menuToggle.focus();
      }

      menuToggle?.addEventListener('click', () => setMenu(!menuOpen()));
      // Any link in the drawer closes it (also covers same-page hash links like /#calculators).
      menu?.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a')) setMenu(false);
      });
      // A click or tap outside the header closes it.
      document.addEventListener('pointerdown', (e) => {
        if (menuOpen() && !header?.contains(e.target as Node)) setMenu(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menuOpen()) setMenu(false, true);
      });
      // Past the md breakpoint the button disappears; don't leave the drawer open behind it.
      matchMedia('(min-width: 48rem)').addEventListener('change', (e) => {
        if (e.matches) setMenu(false);
      });

      // Follow the OS setting until the user picks a theme explicitly.
      media.addEventListener('change', (e) => {
        if (!storedTheme()) apply(e.matches);
      });
    </script>
  </body>
</html>
