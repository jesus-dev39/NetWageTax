---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACT_EMAIL } from '../../lib/site';

const title = 'Form W-2 Box 12 Codes: Complete 2025–2026 Reference Guide';
const description =
  'What every Form W-2 Box 12 code means, including the new Codes TA, TP, and TT under the One Big Beautiful Bill Act, plus D, DD, W, AA and more, and which ones affect your tax return.';
const PUBLISHED = '2026-09-26';
const REVIEWED = '2026-09-26';
const reviewedLabel = new Date(`${REVIEWED}T12:00:00`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const toc = [
  { id: 'what-is-box-12', label: 'What Box 12 is' },
  { id: 'new-codes', label: 'The new codes: TA, TP, and TT' },
  { id: 'code-tp', label: 'Code TP: qualified tips' },
  { id: 'code-tt', label: 'Code TT: qualified overtime' },
  { id: 'code-ta', label: 'Code TA: Trump Account contributions' },
  { id: '2025-vs-2026', label: '2025 vs. 2026 Forms W-2' },
  { id: 'all-codes', label: 'Every Box 12 code at a glance' },
  { id: 'mistakes', label: 'Common mistakes' },
  { id: 'sources', label: 'Sources' },
];

type Effect = 'new' | 'excluded' | 'included' | 'info' | 'owed';

const EFFECT_LABEL: Record<Effect, string> = {
  new: 'New deduction',
  excluded: 'Not in Box 1',
  included: 'Already in Box 1',
  info: 'Informational',
  owed: 'Tax you owe',
};

const EFFECT_CLASS: Record<Effect, string> = {
  new: 'bg-emerald-50 text-emerald-800 ring-emerald-200 dark:bg-emerald-500/10 dark:text-emerald-300 dark:ring-emerald-500/30',
  excluded: 'bg-sky-50 text-sky-800 ring-sky-200 dark:bg-sky-500/10 dark:text-sky-300 dark:ring-sky-500/30',
  included: 'bg-slate-100 text-slate-700 ring-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:ring-slate-700',
  info: 'bg-slate-100 text-slate-700 ring-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:ring-slate-700',
  owed: 'bg-amber-50 text-amber-800 ring-amber-200 dark:bg-amber-500/10 dark:text-amber-300 dark:ring-amber-500/30',
};

const codes: { code: string; reports: string; effect: Effect; action: string }[] = [
  { code: 'TA', reports: 'Employer contributions to a Trump Account (IRC §530A)', effect: 'info', action: 'Nothing to enter for tips or overtime. Generally excluded from income up to the annual limit.' },
  { code: 'TP', reports: 'Qualified tips eligible for the “no tax on tips” deduction', effect: 'new', action: 'Starting amount for Schedule 1-A, Part II. You apply the cap and phase-out yourself.' },
  { code: 'TT', reports: 'Qualified overtime compensation (FLSA overtime premium only)', effect: 'new', action: 'Starting amount for Schedule 1-A, Part III. You apply the cap and phase-out yourself.' },
  { code: 'A', reports: 'Uncollected Social Security or RRTA tax on tips', effect: 'owed', action: 'Your employer couldn’t withhold it. You pay it with your return (Schedule 2).' },
  { code: 'B', reports: 'Uncollected Medicare tax on tips', effect: 'owed', action: 'Same as Code A, for Medicare. Paid with your return (Schedule 2).' },
  { code: 'C', reports: 'Taxable cost of group-term life insurance over $50,000', effect: 'included', action: 'Already counted in Boxes 1, 3, and 5. No extra step.' },
  { code: 'D', reports: 'Elective deferrals to a 401(k) plan, including SIMPLE 401(k)', effect: 'excluded', action: 'Pre-tax savings, excluded from Box 1 but still subject to FICA. May affect the Saver’s Credit.' },
  { code: 'E', reports: 'Elective deferrals to a 403(b) plan', effect: 'excluded', action: 'Same treatment as Code D.' },
  { code: 'F', reports: 'Elective deferrals to a 408(k)(6) SARSEP', effect: 'excluded', action: 'Same treatment as Code D.' },
  { code: 'G', reports: 'Deferrals and employer contributions to a 457(b) plan', effect: 'excluded', action: 'Pre-tax deferred compensation, excluded from Box 1.' },
  { code: 'H', reports: 'Elective deferrals to a 501(c)(18)(D) plan', effect: 'included', action: 'Included in Box 1. You may deduct it on Schedule 1.' },
  { code: 'J', reports: 'Nontaxable sick pay', effect: 'excluded', action: 'Informational; not included in Box 1.' },
  { code: 'K', reports: '20% excise tax on excess golden parachute payments', effect: 'owed', action: 'Reported on Schedule 2.' },
  { code: 'L', reports: 'Substantiated employee business expense reimbursements', effect: 'excluded', action: 'Nontaxable reimbursements under an accountable plan.' },
  { code: 'M', reports: 'Uncollected Social Security/RRTA tax on group-term life insurance (former employees)', effect: 'owed', action: 'Paid with your return (Schedule 2).' },
  { code: 'N', reports: 'Uncollected Medicare tax on group-term life insurance (former employees)', effect: 'owed', action: 'Paid with your return (Schedule 2).' },
  { code: 'P', reports: 'Excludable moving expense reimbursements paid to members of the Armed Forces', effect: 'excluded', action: 'Nontaxable; applies only to active-duty military moves.' },
  { code: 'Q', reports: 'Nontaxable combat pay', effect: 'excluded', action: 'Not taxed, but you can elect to include it for the Earned Income Tax Credit.' },
  { code: 'R', reports: 'Employer contributions to an Archer MSA', effect: 'excluded', action: 'Report on Form 8853.' },
  { code: 'S', reports: 'Salary reduction contributions to a SIMPLE IRA', effect: 'excluded', action: 'Pre-tax savings, excluded from Box 1.' },
  { code: 'T', reports: 'Employer-provided adoption benefits', effect: 'included', action: 'Use Form 8839 to figure the excludable amount.' },
  { code: 'V', reports: 'Income from exercising nonstatutory stock options', effect: 'included', action: 'Already in Boxes 1, 3, and 5. Keep it for your cost basis when you sell.' },
  { code: 'W', reports: 'Employer and pre-tax employee contributions to a Health Savings Account (HSA)', effect: 'excluded', action: 'Report on Form 8889 to check you stayed within the annual limit.' },
  { code: 'Y', reports: 'Deferrals under a §409A nonqualified deferred compensation plan', effect: 'info', action: 'Informational; reporting is optional for employers.' },
  { code: 'Z', reports: 'Income under a nonqualified deferred compensation plan that fails §409A', effect: 'owed', action: 'Already in Box 1, plus an additional 20% tax and interest on Schedule 2.' },
  { code: 'AA', reports: 'Designated Roth contributions to a 401(k) plan', effect: 'included', action: 'After-tax savings; already in Box 1.' },
  { code: 'BB', reports: 'Designated Roth contributions to a 403(b) plan', effect: 'included', action: 'After-tax savings; already in Box 1.' },
  { code: 'DD', reports: 'Cost of employer-sponsored health coverage', effect: 'info', action: 'Informational only. It is not taxable and you do not enter it anywhere.' },
  { code: 'EE', reports: 'Designated Roth contributions to a governmental 457(b) plan', effect: 'included', action: 'After-tax savings; already in Box 1.' },
  { code: 'FF', reports: 'Permitted benefits under a qualified small employer HRA (QSEHRA)', effect: 'info', action: 'May reduce a Premium Tax Credit if you buy Marketplace coverage.' },
  { code: 'GG', reports: 'Income from qualified equity grants under §83(i)', effect: 'included', action: 'Already in Box 1.' },
  { code: 'HH', reports: 'Aggregate deferrals under §83(i) elections', effect: 'info', action: 'Informational.' },
  { code: 'II', reports: 'Medicaid waiver payments excluded from income (Notice 2014-7)', effect: 'excluded', action: 'Excluded from Box 1; may still count as earned income for some credits.' },
];

const sources = [
  { label: 'IRS: About Form W-2, Wage and Tax Statement', href: 'https://www.irs.gov/forms-pubs/about-form-w-2' },
  { label: 'IRS: General Instructions for Forms W-2 and W-3', href: 'https://www.irs.gov/instructions/iw2w3' },
  { label: 'IRS: One, Big, Beautiful Bill provisions', href: 'https://www.irs.gov/newsroom/one-big-beautiful-bill-provisions' },
  { label: 'Congress.gov: H.R. 1, 119th Congress (Public Law 119-21)', href: 'https://www.congress.gov/bill/119th-congress/house-bill/1' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: title,
      description,
      datePublished: PUBLISHED,
      dateModified: REVIEWED,
      author: { '@type': 'Organization', name: 'NetWageTax Editorial Team', url: 'https://netwagetax.com/about/' },
      publisher: { '@id': 'https://netwagetax.com/#organization' },
      mainEntityOfPage: 'https://netwagetax.com/guides/w2-box-12-guide/',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://netwagetax.com/' },
        { '@type': 'ListItem', position: 2, name: 'W-2 Box 12 Guide', item: 'https://netwagetax.com/guides/w2-box-12-guide/' },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-500 dark:text-slate-400">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-navy-700 dark:hover:text-navy-300">Home</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-slate-700 dark:text-slate-300">W-2 Box 12 Guide</li>
        </ol>
      </nav>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">
        Form W-2 Box 12 Codes: Complete 2025–2026 Reference Guide
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-400">
        Box 12 is where your employer reports amounts that don’t fit anywhere else on your W-2: retirement savings,
        health benefits, and, starting with the One Big Beautiful Bill Act, your qualified tips and overtime. Here is
        what each code means and which ones change your tax return.
      </p>
      <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-500 dark:text-slate-400">
        <span>By the <a href="/about/" class="font-medium text-slate-700 underline underline-offset-2 dark:text-slate-300">NetWageTax Editorial Team</a></span>
        <span aria-hidden="true">·</span>
        <span>Last reviewed <time datetime={REVIEWED}>{reviewedLabel}</time></span>
        <span aria-hidden="true">·</span>
        <span>Sources: IRS and statute text</span>
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <nav aria-labelledby="toc-heading" class="rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
      <h2 id="toc-heading" class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">In this guide</h2>
      <ol class="mt-3 grid gap-1.5 text-sm sm:grid-cols-2">
        {
          toc.map(({ id, label }, i) => (
            <li>
              <a href={`#${id}`} class="text-slate-700 hover:text-emerald-700 dark:text-slate-300 dark:hover:text-emerald-400">
                <span class="mr-1.5 tabular-nums text-slate-400">{i + 1}.</span>
                {label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <article class="prose-page mt-10">
      <h2 id="what-is-box-12">What Box 12 is</h2>
      <p>
        Form W-2 reports your wages and the taxes withheld from them. Boxes 1 through 11 cover the big numbers: taxable
        wages, Social Security and Medicare wages, and withholding. Box 12 is for everything else your employer is
        required to report, identified by a one- or two-letter code followed by a dollar amount.
      </p>
      <p>
        Box 12 has room for four entries (12a through 12d). If your employer needs to report more, you’ll receive a
        second W-2 with the additional codes. The code tells you <strong>what</strong> the amount is. It doesn’t tell
        you whether the amount is taxable. Some Box 12 amounts are already included in your Box 1 wages, some are
        excluded, and some are purely informational. The table <a href="#all-codes">further down</a> sorts every code
        into those groups.
      </p>

      <h2 id="new-codes">The new codes: TA, TP, and TT</h2>
      <p>
        The One Big Beautiful Bill Act (H.R. 1, Public Law 119-21), signed on July 4, 2025, created two temporary
        federal income tax deductions, one for qualified tips and one for qualified overtime, available for tax years
        2025 through 2028. It also created Trump Accounts, a new savings account for children. To give workers the
        numbers they need, the IRS added three Box 12 codes to Form W-2.
      </p>
      <p>
        Two of them, <strong>TP</strong> and <strong>TT</strong>, are the starting point for the new deductions. Both
        are claimed on the new <strong>Schedule 1-A</strong> and flow to Form 1040, line 13b. They’re available whether
        you take the standard deduction or itemize. They lower your taxable income, not your adjusted gross income
        (AGI), and they don’t reduce Social Security or Medicare (FICA) taxes.
      </p>

      <h3 id="code-tp">Code TP: qualified tips</h3>
      <p>
        Code TP reports the tips your employer identified as <em>qualified tips</em>: voluntary cash or charged tips
        paid by customers, received in an occupation that customarily and regularly received tips on or before December
        31, 2024. The Treasury Department publishes the list of qualifying occupations. Mandatory service charges, such
        as an automatic 18% gratuity for large parties, are not qualified tips.
      </p>
      <ul>
        <li><strong>Cap:</strong> up to $25,000 per return. The cap is the same for joint filers; it doesn’t double.</li>
        <li>
          <strong>Income phase-out:</strong> the deduction shrinks by $100 for every full $1,000 of modified AGI above
          $150,000 ($300,000 if married filing jointly).
        </li>
        <li>
          <strong>Who qualifies:</strong> you need a valid Social Security number, and married couples must file
          jointly. Self-employed workers can also qualify, unless the tips come from a specified service trade or
          business (such as health, law, or consulting).
        </li>
      </ul>
      <p>
        Your employer reports the full qualified amount. <strong>They don’t apply the $25,000 cap or the phase-out</strong>;
        you apply those on Schedule 1-A.
      </p>

      <h3 id="code-tt">Code TT: qualified overtime</h3>
      <p>
        Code TT reports <em>qualified overtime compensation</em>: overtime pay required by Section 7 of the Fair Labor
        Standards Act (FLSA), usually hours over 40 in a workweek. Only the <strong>premium</strong> portion counts,
        meaning the pay above your regular rate. For time-and-a-half, that’s the extra “half.”
      </p>
      <p>
        <strong>Example:</strong> you earn $20 an hour and work 10 overtime hours at $30 an hour. Your overtime pay is
        $300, but your qualified overtime is only $100 (10 hours × the $10 premium). Code TT should show $100.
      </p>
      <ul>
        <li><strong>Cap:</strong> up to $12,500 per return, or $25,000 if married filing jointly.</li>
        <li><strong>Income phase-out:</strong> the same $100-per-$1,000 reduction above $150,000 ($300,000 joint).</li>
        <li>
          <strong>Who qualifies:</strong> employees who are non-exempt under the FLSA. Overtime that’s paid under a
          union contract or state law, but not required by the FLSA, doesn’t qualify.
        </li>
      </ul>

      <h3 id="code-ta">Code TA: Trump Account contributions</h3>
      <p>
        Code TA reports contributions your employer made to a Trump Account, a tax-advantaged investment account for a
        child created under new IRC §530A. Employers can contribute up to $2,500 a year per employee, and that amount is
        generally excluded from your income. Contributions to these accounts can begin in July 2026.
      </p>
      <p>
        <strong>Code TA has nothing to do with tips or overtime.</strong> Don’t enter it in a tips or overtime
        calculator or on Schedule 1-A.
      </p>

    </article>

    <aside
        aria-label="Calculator"
        class="my-10 rounded-2xl border border-emerald-300 bg-emerald-50 p-6 dark:border-emerald-500/40 dark:bg-emerald-500/10"
      >
        <p class="text-sm font-semibold uppercase tracking-wide text-emerald-800 dark:text-emerald-300">
          Have a TP or TT amount?
        </p>
        <p class="mt-2 text-lg font-semibold text-slate-900 dark:text-slate-100">
          See how much it saves you in federal tax.
        </p>
        <p class="mt-1 text-sm text-slate-700 dark:text-slate-300">
          Enter your Box 12 amounts and income. The calculator applies the caps and phase-out, estimates your tax
          savings, and exports a one-page summary.
        </p>
        <a
          href="/tools/obbba-tax-calculator/"
          class="mt-4 inline-flex items-center gap-2 rounded-lg btn-primary px-5 py-2.5 text-sm font-semibold"
        >
          Open the Tips &amp; Overtime Calculator <span aria-hidden="true">→</span>
        </a>
    </aside>

    <article class="prose-page">
      <h2 id="2025-vs-2026">2025 vs. 2026 Forms W-2</h2>
      <p>
        The deductions apply to tax year 2025, but the law passed mid-year, after payroll systems were set. For 2025,
        the IRS kept Form W-2 unchanged and gave employers transition relief. Many employers reported qualified tips
        and overtime in <strong>Box 14</strong> or on a separate statement instead of in Box 12. If your 2025 W-2 has
        no TP or TT code, look there, or use your final pay stub, and ask your payroll department if you’re unsure.
      </p>
      <p>
        The redesigned <strong>2026 Form W-2</strong>, which you’ll receive in early 2027, carries Codes TA, TP, and TT
        in Box 12. It also splits Box 14, adding a separate box (14b) for the Treasury tipped occupation code that
        identifies your tipped job.
      </p>

      <h2 id="all-codes">Every Box 12 code at a glance</h2>
      <p>
        “Not in Box 1” means the amount was excluded from your taxable wages, usually because it went into a pre-tax
        account. “Already in Box 1” means it’s already part of your taxable wages, so don’t add it again.
      </p>
    </article>

    <div class="mt-6 overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
      <table class="w-full min-w-[40rem] border-collapse text-left text-sm">
        <caption class="sr-only">Form W-2 Box 12 codes, what they report, and how they affect your return</caption>
        <thead class="bg-slate-50 text-slate-900 dark:bg-slate-800/60 dark:text-slate-100">
          <tr>
            <th scope="col" class="w-16 px-4 py-3 font-semibold">Code</th>
            <th scope="col" class="px-4 py-3 font-semibold">What it reports</th>
            <th scope="col" class="w-36 px-4 py-3 font-semibold">Tax effect</th>
            <th scope="col" class="px-4 py-3 font-semibold">What to do</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white dark:divide-slate-800 dark:bg-slate-900">
          {
            codes.map(({ code, reports, effect, action }) => (
              <tr class={effect === 'new' || code === 'TA' ? 'bg-emerald-50/40 dark:bg-emerald-500/5' : ''}>
                <th scope="row" class="px-4 py-3 align-top font-mono font-bold text-slate-900 dark:text-slate-100">
                  {code}
                </th>
                <td class="px-4 py-3 align-top text-slate-700 dark:text-slate-300">{reports}</td>
                <td class="px-4 py-3 align-top">
                  <span class={`inline-block whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-medium ring-1 ${EFFECT_CLASS[effect]}`}>
                    {EFFECT_LABEL[effect]}
                  </span>
                </td>
                <td class="px-4 py-3 align-top text-slate-600 dark:text-slate-400">{action}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <article class="prose-page mt-10">
      <h2 id="mistakes">Common mistakes</h2>
      <ul>
        <li>
          <strong>Entering total overtime pay instead of the premium.</strong> Code TT is only the extra half. If your
          pay stub shows $6,000 of overtime at time-and-a-half, the qualified amount is $2,000.
        </li>
        <li>
          <strong>Adding Box 12 amounts to your wages.</strong> Codes like D, W, and DD don’t increase your taxable
          income. Box 1 already reflects the right number.
        </li>
        <li>
          <strong>Assuming the cap is applied for you.</strong> Your employer reports the full TP and TT amounts. The
          $25,000 and $12,500 caps and the income phase-out are applied on your return.
        </li>
        <li>
          <strong>Expecting lower payroll taxes.</strong> The deductions reduce federal income tax only. Social
          Security and Medicare still apply to 100% of your tips and overtime, and most states still tax them.
        </li>
        <li>
          <strong>Filing separately.</strong> Married couples must file jointly to claim either deduction.
        </li>
      </ul>

      <h2 id="sources">Sources and review</h2>
      <p>
        This guide is written and reviewed by the NetWageTax editorial team from primary sources: the statute and IRS
        forms, instructions, and guidance. It is educational information, not tax advice. For your situation, confirm
        with the official Form W-2 and Schedule 1-A instructions or a CPA or enrolled agent.
      </p>
      <ul>
        {
          sources.map(({ label, href }) => (
            <li>
              <a href={href} rel="noopener" target="_blank">{label}</a>
            </li>
          ))
        }
      </ul>
      <p>
        Spotted something out of date? Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> and we’ll review it.
      </p>
    </article>
  </div>
</BaseLayout>
