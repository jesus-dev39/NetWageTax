---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { CONTACT_EMAIL } from '../../lib/site';

// Search intent: "w2 box 12 codes", "box 12 code dd", "what is code d on w2". Lead with the code list.
const title = 'W-2 Box 12 Codes: What Every Code Means (2026)';
const description =
  'What every W-2 Box 12 code means, from A to II, plus the new TP, TT, and TA codes for tips, overtime, and Trump Accounts, and which ones change your tax return.';
const PUBLISHED = '2026-09-26';
const REVIEWED = '2026-10-04';
const reviewedLabel = new Date(`${REVIEWED}T12:00:00`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const toc = [
  { id: 'all-codes', label: 'Every Box 12 code, A to TT' },
  { id: 'what-is-box-12', label: 'What Box 12 is' },
  { id: 'new-codes', label: 'The new codes: TA, TP, and TT' },
  { id: '2025-vs-2026', label: '2025 vs. 2026 Forms W-2' },
  { id: 'mistakes', label: 'Common mistakes' },
  { id: 'sources', label: 'Sources' },
];

type Effect = 'new' | 'excluded' | 'included' | 'info' | 'owed';

const EFFECT_LABEL: Record<Effect, string> = {
  new: 'New deduction',
  excluded: 'Not in Box 1',
  included: 'Already in Box 1',
  info: 'Informational',
  owed: 'Tax you owe',
};

/** Status tags (docs/DESIGN.md §6): green only for the deduction, warning tint for tax owed. */
const EFFECT_CLASS: Record<Effect, string> = {
  new: 'bg-green-tint text-green',
  excluded: 'bg-surface text-ink-2',
  included: 'bg-surface text-ink-2',
  info: 'bg-surface text-ink-2',
  owed: 'bg-warning-tint text-ink',
};

interface Code {
  code: string;
  /** Short name, used in the heading ("Code D: 401(k) contributions"). */
  name: string;
  /** Plain-English explanation of what the amount is. */
  meaning: string;
  effect: Effect;
  /** What the worker does with it on their return. */
  action: string;
  /** Codes with a full section above link to it instead of getting their own anchor. */
  section?: string;
}

// IRS order (General Instructions for Forms W-2 and W-3). There are no codes I, O, U, X, CC.
const codes: Code[] = [
  {
    code: 'A', name: 'Uncollected Social Security tax on tips', effect: 'owed',
    meaning: 'Your tips were larger than the wages your employer could withhold from, so part of the Social Security (or Railroad Retirement) tax on those tips wasn’t collected.',
    action: 'You owe it. Report it on Schedule 2 and pay it with your return.',
  },
  {
    code: 'B', name: 'Uncollected Medicare tax on tips', effect: 'owed',
    meaning: 'The same as Code A, for the Medicare tax on your tips.',
    action: 'You owe it. Report it on Schedule 2 and pay it with your return.',
  },
  {
    code: 'C', name: 'Group-term life insurance over $50,000', effect: 'included',
    meaning: 'Life insurance your employer pays for is a taxable benefit once coverage passes $50,000. This is the taxable cost of the coverage above that amount.',
    action: 'Nothing to do. It’s already counted in Boxes 1, 3, and 5.',
  },
  {
    code: 'D', name: '401(k) contributions', effect: 'excluded',
    meaning: 'The pre-tax amount you chose to put into your 401(k), including a SIMPLE 401(k). It’s left out of your taxable wages in Box 1 but still counts for Social Security and Medicare (Boxes 3 and 5).',
    action: 'Nothing to enter. Your Box 1 wages already reflect it. It can matter for the Saver’s Credit (Form 8880).',
  },
  {
    code: 'E', name: '403(b) contributions', effect: 'excluded',
    meaning: 'Pre-tax contributions to a 403(b) plan, the retirement plan used by schools, hospitals, and nonprofits.',
    action: 'Nothing to enter. Treated like Code D.',
  },
  {
    code: 'F', name: 'SARSEP contributions', effect: 'excluded',
    meaning: 'Pre-tax contributions to a salary reduction SEP (SARSEP) under section 408(k)(6), an older small-employer retirement plan.',
    action: 'Nothing to enter. Treated like Code D.',
  },
  {
    code: 'G', name: '457(b) contributions', effect: 'excluded',
    meaning: 'Pre-tax deferrals, and any employer contributions, to a 457(b) deferred compensation plan, common for state and local government workers.',
    action: 'Nothing to enter. It’s already left out of Box 1.',
  },
  {
    code: 'H', name: '501(c)(18)(D) plan contributions', effect: 'included',
    meaning: 'Contributions to a pension plan created before June 25, 1959, and funded only by employee contributions. Unlike a 401(k), these are included in your Box 1 wages.',
    action: 'You can deduct the amount as an adjustment to income on Schedule 1.',
  },
  {
    code: 'J', name: 'Nontaxable sick pay', effect: 'excluded',
    meaning: 'Sick pay that isn’t taxable, usually because you paid the premiums for the disability policy with after-tax money.',
    action: 'Nothing to do. It isn’t in Box 1.',
  },
  {
    code: 'K', name: 'Excise tax on golden parachute payments', effect: 'owed',
    meaning: 'The 20% excise tax your employer withheld on excess golden parachute payments, made when a company changes ownership.',
    action: 'Report it on Schedule 2.',
  },
  {
    code: 'L', name: 'Business expense reimbursements', effect: 'excluded',
    meaning: 'Travel, mileage, or per diem reimbursements you accounted for to your employer, up to the federal rate. Anything paid above that rate is already in Box 1.',
    action: 'Nothing to do. These reimbursements aren’t taxable.',
  },
  {
    code: 'M', name: 'Uncollected Social Security tax on group-term life insurance', effect: 'owed',
    meaning: 'For former employees: Social Security (or RRTA) tax on group-term life insurance coverage over $50,000 that your employer couldn’t collect.',
    action: 'You owe it. Report it on Schedule 2 and pay it with your return.',
  },
  {
    code: 'N', name: 'Uncollected Medicare tax on group-term life insurance', effect: 'owed',
    meaning: 'For former employees: the same as Code M, for the Medicare tax.',
    action: 'You owe it. Report it on Schedule 2 and pay it with your return.',
  },
  {
    code: 'P', name: 'Military moving expense reimbursements', effect: 'excluded',
    meaning: 'Moving expenses your employer paid or reimbursed for a member of the U.S. Armed Forces on active duty who moved because of a military order.',
    action: 'Nothing to do. They aren’t taxable.',
  },
  {
    code: 'Q', name: 'Nontaxable combat pay', effect: 'excluded',
    meaning: 'Military pay earned in a combat zone, which isn’t taxable.',
    action: 'Not taxed, but you can choose to count it as earned income for the Earned Income Tax Credit if that gives you a bigger credit.',
  },
  {
    code: 'R', name: 'Archer MSA contributions', effect: 'excluded',
    meaning: 'Employer contributions to an Archer medical savings account.',
    action: 'Report them on Form 8853.',
  },
  {
    code: 'S', name: 'SIMPLE IRA contributions', effect: 'excluded',
    meaning: 'The pre-tax amount you chose to put into a SIMPLE IRA through payroll.',
    action: 'Nothing to enter. It’s already left out of Box 1.',
  },
  {
    code: 'T', name: 'Adoption benefits', effect: 'excluded',
    meaning: 'Adoption expenses your employer paid or reimbursed under an adoption assistance program. They’re left out of Box 1, but only up to the yearly limit.',
    action: 'Fill out Form 8839 to figure how much is tax-free. Any amount over the limit is added to your wages.',
  },
  {
    code: 'V', name: 'Stock option income', effect: 'included',
    meaning: 'The income from exercising nonstatutory stock options: the difference between the stock’s value and the price you paid.',
    action: 'Already in Boxes 1, 3, and 5. Keep it to figure your cost basis when you sell the shares.',
  },
  {
    code: 'W', name: 'Health Savings Account (HSA) contributions', effect: 'excluded',
    meaning: 'Your employer’s contributions to your HSA, plus anything you put in pre-tax through payroll.',
    action: 'Report it on Form 8889, which checks that total contributions stayed within the annual limit.',
  },
  {
    code: 'Y', name: 'Section 409A deferrals', effect: 'info',
    meaning: 'Pay you deferred into a nonqualified deferred compensation plan. Employers aren’t required to report it.',
    action: 'Nothing to do.',
  },
  {
    code: 'Z', name: 'Income from a plan that fails section 409A', effect: 'owed',
    meaning: 'Deferred compensation that became taxable because the plan didn’t meet the section 409A rules.',
    action: 'Already in Box 1. You also owe an extra 20% tax plus interest, reported on Schedule 2.',
  },
  {
    code: 'AA', name: 'Roth 401(k) contributions', effect: 'included',
    meaning: 'After-tax contributions you made to a designated Roth account in your 401(k).',
    action: 'Nothing to enter. They’re already in Box 1.',
  },
  {
    code: 'BB', name: 'Roth 403(b) contributions', effect: 'included',
    meaning: 'After-tax contributions you made to a designated Roth account in your 403(b).',
    action: 'Nothing to enter. They’re already in Box 1.',
  },
  {
    code: 'DD', name: 'Cost of employer health coverage', effect: 'info',
    meaning: 'The total cost of your employer-sponsored health insurance, including both your share and your employer’s. It’s reported so you know what your coverage costs.',
    action: 'Nothing to do. It isn’t taxable and you don’t enter it anywhere.',
  },
  {
    code: 'EE', name: 'Roth 457(b) contributions', effect: 'included',
    meaning: 'After-tax contributions you made to a designated Roth account in a governmental 457(b) plan.',
    action: 'Nothing to enter. They’re already in Box 1.',
  },
  {
    code: 'FF', name: 'Small employer HRA (QSEHRA) benefits', effect: 'info',
    meaning: 'The yearly amount you could get from a qualified small employer health reimbursement arrangement.',
    action: 'If you buy Marketplace coverage, it can lower your Premium Tax Credit (Form 8962).',
  },
  {
    code: 'GG', name: 'Section 83(i) equity grant income', effect: 'included',
    meaning: 'Income from stock received under a qualified equity grant whose tax you had deferred under section 83(i).',
    action: 'Already in Box 1.',
  },
  {
    code: 'HH', name: 'Section 83(i) deferrals', effect: 'info',
    meaning: 'The total amount you’ve deferred under section 83(i) elections, as of the end of the year.',
    action: 'Nothing to do.',
  },
  {
    code: 'II', name: 'Medicaid waiver payments', effect: 'excluded',
    meaning: 'Payments for caring for someone in your home under a Medicaid waiver program, excluded from income under IRS Notice 2014-7.',
    action: 'Not in Box 1. You may still choose to count them as earned income for the Earned Income Tax Credit.',
  },
  {
    code: 'TA', name: 'Trump Account contributions', effect: 'info', section: 'code-ta',
    meaning: 'Your employer’s contributions to a Trump Account, a savings account for a child created by the One Big Beautiful Bill Act.',
    action: 'Generally not taxable up to $2,500 a year. It has nothing to do with tips or overtime.',
  },
  {
    code: 'TP', name: 'Qualified tips', effect: 'new', section: 'code-tp',
    meaning: 'Tips your employer identified as qualified for the federal “no tax on tips” deduction.',
    action: 'Starting amount for Schedule 1-A, Part II. You apply the $25,000 cap and the income phase-out yourself.',
  },
  {
    code: 'TT', name: 'Qualified overtime', effect: 'new', section: 'code-tt',
    meaning: 'The overtime premium (the extra “half” in time-and-a-half) that qualifies for the federal overtime deduction.',
    action: 'Starting amount for Schedule 1-A, Part III. You apply the $12,500 cap and the income phase-out yourself.',
  },
];

/** Every code has one anchor: the new codes point to their full section, the rest to their entry in the list. */
const anchor = (c: Code) => c.section ?? `code-${c.code.toLowerCase()}`;

const sources = [
  { label: 'IRS: About Form W-2, Wage and Tax Statement', href: 'https://www.irs.gov/forms-pubs/about-form-w-2' },
  { label: 'IRS: General Instructions for Forms W-2 and W-3', href: 'https://www.irs.gov/instructions/iw2w3' },
  { label: 'IRS: One, Big, Beautiful Bill provisions', href: 'https://www.irs.gov/newsroom/one-big-beautiful-bill-provisions' },
  { label: 'Congress.gov: H.R. 1, 119th Congress (Public Law 119-21)', href: 'https://www.congress.gov/bill/119th-congress/house-bill/1' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: title,
      description,
      datePublished: PUBLISHED,
      dateModified: REVIEWED,
      author: { '@type': 'Organization', name: 'NetWageTax', url: 'https://netwagetax.com/about/' },
      publisher: { '@id': 'https://netwagetax.com/#organization' },
      mainEntityOfPage: 'https://netwagetax.com/guides/w2-box-12-guide/',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://netwagetax.com/' },
        { '@type': 'ListItem', position: 2, name: 'W-2 Box 12 codes', item: 'https://netwagetax.com/guides/w2-box-12-guide/' },
      ],
    },
  ],
};

const linkClass = 'text-link underline underline-offset-[3px] hover:decoration-2';
---

<BaseLayout title={title} description={description} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <PageHeader
    title="W-2 Box 12 codes: what each code means"
    lead="Box 12 is where your employer reports amounts that don’t fit anywhere else on your W-2: retirement savings, health benefits, and, starting with the One Big Beautiful Bill Act, your qualified tips and overtime. Find your code below to see what it is and whether it changes your tax return."
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'W-2 Box 12 codes' }]}
  >
    <p class="mt-6 text-[15px] text-ink-2">
      By <a href="/about/" class={linkClass}>NetWageTax</a>. Last reviewed{' '}
      <time datetime={REVIEWED}>{reviewedLabel}</time>. Sources: IRS instructions and the statute.
    </p>
  </PageHeader>

  <div class="container-page py-10">
    <div class="max-w-3xl">
      <nav aria-labelledby="find-code-heading">
        <h2 id="find-code-heading" class="text-xl/[1.3] font-bold text-ink">Find your code</h2>
        <ul class="mt-3 grid grid-cols-6 gap-x-2 gap-y-1 text-lg sm:grid-cols-9">
          {
            codes.map((c) => (
              <li>
                <a href={`#${anchor(c)}`} class={`${linkClass} inline-flex min-h-11 min-w-11 items-center font-semibold`}>
                  {c.code}
                  <span class="sr-only">: {c.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="toc-heading" class="mt-8 border-t border-line pt-6">
        <h2 id="toc-heading" class="text-xl/[1.3] font-bold text-ink">On this page</h2>
        <ol class="mt-3 list-decimal space-y-1.5 pl-6">
          {
            toc.map(({ id, label }) => (
              <li>
                <a href={`#${id}`} class={linkClass}>
                  {label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <section aria-labelledby="all-codes" class="mt-12">
        <h2 id="all-codes" class="scroll-mt-20 text-2xl/[1.2] font-bold tracking-[-0.01em] text-ink md:text-[1.75rem]">
          Every Box 12 code, A to TT
        </h2>
        <p class="mt-3 text-ink">
          Each entry on your W-2 is a code and a dollar amount. <strong class="font-semibold">Not in Box 1</strong> means
          the amount was left out of your taxable wages, usually because it went into a pre-tax account.{' '}
          <strong class="font-semibold">Already in Box 1</strong> means it’s part of your taxable wages, so don’t add it
          again. <strong class="font-semibold">Tax you owe</strong> means you pay something extra with your return.
        </p>

        <ul class="mt-6 border-t border-line">
          {
            codes.map((c) => (
              <li id={c.section ? undefined : anchor(c)} class="scroll-mt-20 border-b border-line py-5">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
                  <h3 class="text-xl/[1.3] font-bold text-ink">
                    Code {c.code}: {c.name}
                  </h3>
                  <span class={`rounded-[2px] px-2 py-0.5 text-sm font-semibold ${EFFECT_CLASS[c.effect]}`}>
                    {EFFECT_LABEL[c.effect]}
                  </span>
                </div>
                <p class="mt-2 text-ink">{c.meaning}</p>
                <p class="mt-2 text-ink-2">
                  <span class="font-semibold text-ink">What to do:</span> {c.action}
                  {c.section && (
                    <>
                      {' '}
                      <a href={`#${c.section}`} class={linkClass}>
                        Full explanation of Code {c.code}
                      </a>
                    </>
                  )}
                </p>
              </li>
            ))
          }
        </ul>
      </section>

      <article class="prose-page mt-12">
        <h2 id="what-is-box-12">What Box 12 is</h2>
        <p>
          Form W-2 reports your wages and the taxes withheld from them. Boxes 1 through 11 cover the big numbers: taxable
          wages, Social Security and Medicare wages, and withholding. Box 12 is for everything else your employer is
          required to report, identified by a one- or two-letter code followed by a dollar amount.
        </p>
        <p>
          Box 12 has room for four entries (12a through 12d). If your employer needs to report more, you’ll receive a
          second W-2 with the additional codes. The code tells you <strong>what</strong> the amount is. It doesn’t tell you
          whether the amount is taxable. Some Box 12 amounts are already included in your Box 1 wages, some are excluded,
          and some are purely informational. The <a href="#all-codes">code list</a> sorts every code into those groups.
        </p>

        <h2 id="new-codes">The new codes: TA, TP, and TT</h2>
        <p>
          The One Big Beautiful Bill Act (H.R. 1, Public Law 119-21), signed on July 4, 2025, created two temporary
          federal income tax deductions, one for qualified tips and one for qualified overtime, available for tax years
          2025 through 2028. It also created Trump Accounts, a new savings account for children. To give workers the
          numbers they need, the IRS added three Box 12 codes to Form W-2.
        </p>
        <p>
          Two of them, <strong>TP</strong> and <strong>TT</strong>, are the starting point for the new deductions. Both
          are claimed on the new <strong>Schedule 1-A</strong> and carry to Form 1040. They’re available whether
          you take the standard deduction or itemize. They lower your taxable income, not your adjusted gross income
          (AGI), and they don’t reduce Social Security or Medicare (FICA) taxes.
        </p>

        <h3 id="code-tp" class="scroll-mt-20">Code TP: qualified tips</h3>
        <p>
          Code TP reports the tips your employer identified as <em>qualified tips</em>: voluntary cash or charged tips
          paid by customers, received in an occupation that customarily and regularly received tips on or before December
          31, 2024. The Treasury Department publishes the list of qualifying occupations. Mandatory service charges, such
          as an automatic 18% gratuity for large parties, are not qualified tips.
        </p>
        <ul>
          <li><strong>Cap:</strong> up to $25,000 per return. The cap is the same for joint filers; it doesn’t double.</li>
          <li>
            <strong>Income phase-out:</strong> the deduction shrinks by $100 for every full $1,000 of modified AGI above
            $150,000 ($300,000 if married filing jointly).
          </li>
          <li>
            <strong>Who qualifies:</strong> you need a valid Social Security number, and married couples must file
            jointly. Self-employed workers can also qualify, unless the tips come from a specified service trade or
            business (such as health, law, or consulting).
          </li>
        </ul>
        <p>
          Your employer reports the full qualified amount. <strong>They don’t apply the $25,000 cap or the phase-out</strong>;
          you apply those on Schedule 1-A.
        </p>

        <h3 id="code-tt" class="scroll-mt-20">Code TT: qualified overtime</h3>
        <p>
          Code TT reports <em>qualified overtime compensation</em>: overtime pay required by Section 7 of the Fair Labor
          Standards Act (FLSA), usually hours over 40 in a workweek. Only the <strong>premium</strong> portion counts,
          meaning the pay above your regular rate. For time-and-a-half, that’s the extra “half.”
        </p>
        <p>
          <strong>Example:</strong> you earn $20 an hour and work 10 overtime hours at $30 an hour. Your overtime pay is
          $300, but your qualified overtime is only $100 (10 hours × the $10 premium). Code TT should show $100.
        </p>
        <ul>
          <li><strong>Cap:</strong> up to $12,500 per return, or $25,000 if married filing jointly.</li>
          <li><strong>Income phase-out:</strong> the same $100-per-$1,000 reduction above $150,000 ($300,000 joint).</li>
          <li>
            <strong>Who qualifies:</strong> employees who are non-exempt under the FLSA. Overtime that’s paid under a union
            contract or state law, but not required by the FLSA, doesn’t qualify.
          </li>
        </ul>

        <h3 id="code-ta" class="scroll-mt-20">Code TA: Trump Account contributions</h3>
        <p>
          Code TA reports contributions your employer made to a Trump Account, a tax-advantaged investment account for a
          child created under new IRC §530A. Employers can contribute up to $2,500 a year per employee, and that amount is
          generally excluded from your income. Contributions to these accounts can begin in July 2026.
        </p>
        <p>
          <strong>Code TA has nothing to do with tips or overtime.</strong> Don’t enter it in a tips or overtime calculator
          or on Schedule 1-A.
        </p>
      </article>

      <aside aria-labelledby="calc-heading" class="my-10 border-y border-line py-6">
        <h2 id="calc-heading" class="text-xl/[1.3] font-bold text-ink">Have a TP or TT amount?</h2>
        <p class="mt-2 text-ink-2">
          Enter your Box 12 amounts and income. The calculator applies the caps and phase-out, estimates your federal tax
          savings, and exports a one-page summary.
        </p>
        <a
          href="/tools/obbba-tax-calculator/"
          class="btn-primary mt-4 inline-flex h-11 items-center rounded-control px-5 font-semibold"
        >
          Estimate your tips and overtime deduction
        </a>
      </aside>

      <article class="prose-page">
        <h2 id="2025-vs-2026">2025 vs. 2026 Forms W-2</h2>
        <p>
          The deductions apply to tax year 2025, but the law passed mid-year, after payroll systems were set. For 2025, the
          IRS kept Form W-2 unchanged and gave employers transition relief. Many employers reported qualified tips and
          overtime in <strong>Box 14</strong> or on a separate statement instead of in Box 12. If your 2025 W-2 has no TP
          or TT code, look there, or use your final pay stub, and ask your payroll department if you’re unsure.
        </p>
        <p>
          The redesigned <strong>2026 Form W-2</strong>, which you’ll receive in early 2027, carries Codes TA, TP, and TT in
          Box 12. It also splits Box 14, adding a separate box (14b) for the Treasury tipped occupation code that
          identifies your tipped job.
        </p>

        <h2 id="mistakes">Common mistakes</h2>
        <ul>
          <li>
            <strong>Entering total overtime pay instead of the premium.</strong> Code TT is only the extra half. If your pay
            stub shows $6,000 of overtime at time-and-a-half, the qualified amount is $2,000.
          </li>
          <li>
            <strong>Adding Box 12 amounts to your wages.</strong> Codes like D, W, and DD don’t increase your taxable
            income. Box 1 already reflects the right number.
          </li>
          <li>
            <strong>Assuming the cap is applied for you.</strong> Your employer reports the full TP and TT amounts. The
            $25,000 and $12,500 caps and the income phase-out are applied on your return.
          </li>
          <li>
            <strong>Expecting lower payroll taxes.</strong> The deductions reduce federal income tax only. Social Security
            and Medicare still apply to 100% of your tips and overtime, and most states still tax them.
          </li>
          <li>
            <strong>Filing separately.</strong> Married couples must file jointly to claim either deduction.
          </li>
        </ul>

        <h2 id="sources">Sources and review</h2>
        <p>
          This guide is written and reviewed by NetWageTax from primary sources: the statute and IRS
          forms, instructions, and guidance. It is educational information, not tax advice. For your situation, confirm
          with the official Form W-2 and Schedule 1-A instructions or a CPA or enrolled agent.
        </p>
        <ul>
          {
            sources.map(({ label, href }) => (
              <li>
                <a href={href} rel="noopener" target="_blank">{label}</a>
              </li>
            ))
          }
        </ul>
        <p>
          Spotted something out of date? Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> and we’ll review it.
        </p>
      </article>
    </div>
  </div>
</BaseLayout>
