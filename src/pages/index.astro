---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePaycheckEstimate from '../components/HomePaycheckEstimate';
import { formatUSD } from '../components/CurrencyInput';
import { SOCIAL_SECURITY_WAGE_BASE_2026 } from '../lib/fica';
import { STANDARD_DEDUCTION_2026, TAX_BRACKETS_2026 } from '../lib/marginal-rate';
import { SITE_TAX_YEAR } from '../lib/site';
import { statePagePath, STATES, type TaxStructure } from '../lib/state-tax-data';

// The parameters the estimate uses, read from the same constants as the engine.
const rates = TAX_BRACKETS_2026.single.map((b) => b.rate * 100);
const facts = [
  { label: 'Federal brackets', value: `${SITE_TAX_YEAR}, ${Math.min(...rates)}% to ${Math.max(...rates)}%` },
  { label: 'Standard deduction (single)', value: formatUSD(STANDARD_DEDUCTION_2026.single) },
  { label: 'Social Security wage base', value: formatUSD(SOCIAL_SECURITY_WAGE_BASE_2026) },
  { label: 'States covered', value: `${STATES.length - 1} and DC` },
];

const tools = [
  {
    href: '/tools/obbba-tax-calculator/',
    title: 'Tips and overtime deduction',
    body: `Estimate your ${SITE_TAX_YEAR} Schedule 1-A deduction and what it saves in federal tax.`,
  },
  {
    href: '/guides/w2-box-12-guide/',
    title: 'W-2 Box 12 codes',
    body: 'What each code means, including the new TA, TP, and TT.',
  },
];

// All 51 state pages as plain links: important internal links for search.
const stateGroups: { structure: TaxStructure; title: string; columns: string }[] = [
  { structure: 'none', title: 'No income tax', columns: 'columns-2 lg:columns-1' },
  { structure: 'flat', title: 'Flat rate', columns: 'columns-2' },
  { structure: 'graduated', title: 'Progressive brackets', columns: 'columns-2 lg:columns-3' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://netwagetax.com/#organization',
      name: 'NetWageTax',
      url: 'https://netwagetax.com/',
      logo: 'https://netwagetax.com/apple-touch-icon.png',
    },
    {
      '@type': 'WebSite',
      name: 'NetWageTax',
      url: 'https://netwagetax.com/',
      publisher: { '@id': 'https://netwagetax.com/#organization' },
    },
  ],
};
---

<BaseLayout
  title={`NetWageTax: Free ${SITE_TAX_YEAR} Paycheck Calculator and Workplace Tax Tools`}
  description={`Free ${SITE_TAX_YEAR} paycheck calculator: see your take-home pay after federal income tax, Social Security, Medicare, and state tax. Plus tips and overtime deduction estimates, state income tax pages, and W-2 Box 12 codes.`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Header: the paycheck estimate is the page's main content (docs/DESIGN.md §8). -->
  <section id="calculators" aria-labelledby="home-heading" class="scroll-mt-20 border-b border-line">
    <div class="container-page grid gap-6 pb-10 pt-6 sm:pb-14 sm:pt-10 lg:grid-cols-[4fr_8fr] lg:gap-12 lg:pb-16 lg:pt-12">
      <div>
        <h1 id="home-heading" class="text-[2rem]/[1.15] font-bold tracking-[-0.02em] text-ink md:text-[2.75rem]/[1.1]">
          Figure out your <span class="whitespace-nowrap">take-home</span> pay
        </h1>
        <p class="mt-3 text-lg/[1.5] text-ink-2 md:mt-4 md:text-xl/[1.5]">
          Enter your pay to see what is left after federal income tax, Social Security, Medicare, and state tax.
        </p>
        <dl class="mt-8 hidden border-t border-line lg:block">
          {
            facts.map(({ label, value }) => (
              <div class="flex justify-between gap-4 border-b border-line py-2.5">
                <dt class="text-ink-2">{label}</dt>
                <dd class="num text-right font-semibold text-ink">{value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-4 hidden text-[15px] text-ink-2 lg:block">Your figures stay on this device. Nothing is sent or stored.</p>
      </div>

      <div>
        <HomePaycheckEstimate client:load />
        <p class="mt-4 text-[15px] text-ink-2 lg:hidden">
          {SITE_TAX_YEAR} federal brackets, FICA, and all {STATES.length - 1} states and DC. Your figures stay on this device.
        </p>
      </div>
    </div>
  </section>

  <section aria-labelledby="tools-heading">
    <div class="container-page py-10 sm:py-14">
      <h2 id="tools-heading" class="text-2xl/[1.2] font-bold tracking-[-0.01em] text-ink md:text-[1.75rem]">Other tools</h2>
      <ul class="mt-4 grid border-t border-line md:grid-cols-2 md:gap-x-8">
        {
          tools.map(({ href, title, body }) => (
            <li class="border-b border-line py-5">
              <a href={href} class="text-[19px] font-semibold text-link underline underline-offset-[3px] hover:decoration-2">
                {title}
              </a>
              <p class="mt-1 text-ink-2">{body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-labelledby="states-heading">
    <div class="container-page pb-12 sm:pb-16">
      <h2 id="states-heading" class="text-2xl/[1.2] font-bold tracking-[-0.01em] text-ink md:text-[1.75rem]">
        {SITE_TAX_YEAR} income tax by state
      </h2>
      <p class="mt-2 text-ink-2">
        Each state decides whether to follow the federal tips and overtime deduction.{' '}
        <a href="/state-taxes/" class="text-link underline underline-offset-[3px] hover:decoration-2">Open the state tax map</a>
      </p>
      <div class="mt-6 grid gap-8 border-t border-line pt-5 lg:grid-cols-[8fr_15fr_28fr]">
        {
          stateGroups.map(({ structure, title, columns }) => {
            const group = STATES.filter((s) => s.structure === structure);
            return (
              <div>
                <h3 class="font-bold text-ink">
                  {title} <span class="num font-normal text-ink-2">({group.length})</span>
                </h3>
                <ul class={`mt-2 gap-x-6 leading-8 ${columns}`}>
                  {group.map((s) => (
                    <li class="break-inside-avoid">
                      <a href={statePagePath(s)} class="whitespace-nowrap text-link underline underline-offset-[3px] hover:decoration-2">
                        {s.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>
