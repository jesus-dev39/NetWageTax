---
import BaseLayout from '../layouts/BaseLayout.astro';
import { STATES, STRUCTURE_LABELS, type TaxStructure } from '../lib/state-tax-data';

const calculatorFeatures = [
  'Qualified tips deduction up to $25,000 and overtime up to $12,500 ($25,000 joint)',
  'Step-by-step MAGI phase-out above $150,000 ($300,000 joint)',
  'Estimated federal tax savings, FICA, and state income tax in one breakdown',
  'Export a one-page PDF or Word summary for your records or your tax preparer',
];

const tools = [
  {
    href: '/state-taxes',
    eyebrow: 'All 50 states + DC',
    title: '50-State Income Tax Directory & Map',
    body: 'An interactive map of which states tax wages, which use a flat rate, and which use progressive brackets, with local tax notes for each state.',
    cta: 'Explore the map',
  },
  {
    href: '/guides/w2-box-12-guide',
    eyebrow: 'Reference guide',
    title: 'Form W-2 Box 12 Code Reference Guide',
    body: 'What every Box 12 code means, from the new TA, TP, and TT codes to common ones like D, DD, and W, and which ones affect your return.',
    cta: 'Read the guide',
  },
];

const trust = [
  {
    title: 'Private by design',
    body: 'Every calculation runs in your browser. We never ask for your name, email, or Social Security number, and nothing you type is sent to a server.',
    icon: 'M10 2.5 16 5v4.5c0 4-2.6 6.9-6 8-3.4-1.1-6-4-6-8V5l6-2.5Z M7.5 10l1.75 1.75L12.75 8',
  },
  {
    title: 'Built on current 2026 IRS rules',
    body: 'Caps, thresholds, and phase-outs come from the statute and IRS guidance, and every result shows the math. We update the tools when the rules change.',
    icon: 'M4 3.5h8.5L16 7v9.5H4z M12.5 3.5V7H16 M7 10.5h6 M7 13.5h4',
  },
  {
    title: 'Zero sign-up',
    body: 'No account, no email wall, no upsell. Open a tool, get your estimate, and export a summary if you want one.',
    icon: 'M10 17.5a7.5 7.5 0 1 0 0-15 7.5 7.5 0 0 0 0 15Z M6.75 10.25 9 12.5l4.25-4.5',
  },
];

const structures: TaxStructure[] = ['none', 'flat', 'graduated'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://netwagetax.com/#organization',
      name: 'NetWageTax',
      url: 'https://netwagetax.com/',
      logo: 'https://netwagetax.com/apple-touch-icon.png',
    },
    {
      '@type': 'WebSite',
      name: 'NetWageTax',
      url: 'https://netwagetax.com/',
      publisher: { '@id': 'https://netwagetax.com/#organization' },
    },
  ],
};
---

<BaseLayout
  title="NetWageTax: Independent US Workplace Tax & Paycheck Calculators"
  description="Free, independent calculators for American workers. Estimate your 2026 tips and overtime deduction, compare state income taxes, and decode your W-2 Box 12 codes."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
      <p class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-sm font-medium text-emerald-800 ring-1 ring-emerald-200 dark:bg-emerald-500/10 dark:text-emerald-300 dark:ring-emerald-500/30">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
        Updated for the 2026 tax year
      </p>
      <h1 class="mt-6 max-w-3xl text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl dark:text-slate-100">
        Independent US Workplace Tax &amp; Paycheck Calculators
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
        Clear estimates built on current IRS rules, for the workers the 2026 tax changes affect most. No sign-up, no
        sales pitch, and nothing you enter leaves your browser.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/tools/obbba-tax-calculator"
          class="inline-flex items-center gap-2 rounded-lg btn-primary px-5 py-3 font-medium"
        >
          Calculate my tips &amp; overtime deduction <span aria-hidden="true">→</span>
        </a>
        <a
          href="#tools"
          class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-5 py-3 font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
        >
          Browse all tools
        </a>
      </div>
    </div>
  </section>

  <!-- Tools -->
  <section id="tools" aria-labelledby="tools-heading" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 id="tools-heading" class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">
        Calculators &amp; references
      </h2>
      <p class="mt-2 text-slate-600 dark:text-slate-400">
        Built for the federal deductions that apply from the 2025 through 2028 tax years.
      </p>

      <div class="mt-8 grid gap-6 lg:grid-cols-3">
        <article
          aria-labelledby="featured-tool-title"
          class="flex flex-col rounded-2xl border border-emerald-300 bg-white p-6 shadow-sm ring-1 ring-emerald-200 sm:p-8 lg:col-span-2 lg:row-span-2 dark:border-emerald-500/40 dark:bg-slate-900 dark:ring-emerald-500/20"
        >
          <span class="self-start rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-200 dark:bg-emerald-500/10 dark:text-emerald-300 dark:ring-emerald-500/30">
            Featured · New for 2026
          </span>
          <h3 id="featured-tool-title" class="mt-4 text-2xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">
            2026 OBBBA Tips &amp; Overtime Calculator
          </h3>
          <p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-400">
            The One Big Beautiful Bill Act created two new federal income tax deductions: one for qualified tips and one
            for qualified overtime pay. This calculator follows the Schedule 1-A method to estimate what you can deduct,
            and what it saves you in real dollars.
          </p>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {
              calculatorFeatures.map((f) => (
                <li class="flex items-start gap-2 text-sm text-slate-700 dark:text-slate-300">
                  <span class="mt-0.5 text-emerald-600 dark:text-emerald-400" aria-hidden="true">✓</span>
                  {f}
                </li>
              ))
            }
          </ul>
          <div class="mt-auto pt-8">
            <a
              href="/tools/obbba-tax-calculator"
              class="inline-flex items-center gap-2 rounded-lg btn-primary px-5 py-3 font-medium"
            >
              Open the calculator <span aria-hidden="true">→</span>
            </a>
            <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">Free. No sign-up. Takes about two minutes.</p>
          </div>
        </article>

        {
          tools.map((t) => (
            <a
              href={t.href}
              class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-emerald-300 hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600/40 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-emerald-500/40"
            >
              <span class="text-xs font-semibold uppercase tracking-wide text-emerald-700 dark:text-emerald-400">{t.eyebrow}</span>
              <h3 class="mt-2 text-lg font-semibold text-slate-900 dark:text-slate-100">{t.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{t.body}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-emerald-700 dark:text-emerald-400">
                {t.cta}
                <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why NetWageTax -->
  <section aria-labelledby="why-heading" class="border-y border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 id="why-heading" class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">Why NetWageTax</h2>
      <p class="mt-2 max-w-2xl text-slate-600 dark:text-slate-400">
        An independent project, not affiliated with the IRS, any employer, or any tax preparation company.
      </p>
      <dl class="mt-10 grid gap-8 sm:grid-cols-3">
        {
          trust.map(({ title, body, icon }) => (
            <div>
              <dt class="flex items-center gap-3 font-semibold text-slate-900 dark:text-slate-100">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200 dark:bg-emerald-500/10 dark:text-emerald-400 dark:ring-emerald-500/30">
                  <svg viewBox="0 0 20 20" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={icon} />
                  </svg>
                </span>
                {title}
              </dt>
              <dd class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- State directory -->
  <section aria-labelledby="states-heading">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="states-heading" class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">
            Browse 2026 income tax by state
          </h2>
          <p class="mt-2 text-slate-600 dark:text-slate-400">
            The federal tips and overtime deduction doesn't change what your state charges.
          </p>
        </div>
        <a href="/state-taxes" class="text-sm font-medium text-emerald-700 hover:underline dark:text-emerald-400">
          Open the interactive map →
        </a>
      </div>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        {
          structures.map((structure) => {
            const group = STATES.filter((s) => s.structure === structure);
            return (
              <div>
                <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                  {STRUCTURE_LABELS[structure]} ({group.length})
                </h3>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {group.map((s) => (
                    <li>
                      <a
                        href={`/state-taxes?state=${s.slug}`}
                        class="inline-block rounded-md border border-slate-200 bg-white px-2.5 py-1 text-sm text-slate-700 transition hover:border-emerald-300 hover:text-emerald-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-emerald-500/40 dark:hover:text-emerald-400"
                      >
                        {s.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>
