---
import BaseLayout from '../layouts/BaseLayout.astro';

const features = [
  {
    title: 'Tips and overtime, side by side',
    body: 'Estimate the qualified tips deduction (up to $25,000) and the qualified overtime deduction (up to $12,500, or $25,000 if married filing jointly) in one place.',
  },
  {
    title: 'W-2 Box 12 decoder',
    body: 'Plain-English explanations of the new Codes TA, TP, and TT, including the common mistake of entering total overtime pay instead of just the premium.',
  },
  {
    title: 'Income phase-out, step by step',
    body: 'See exactly how the $100-per-$1,000 MAGI reduction applies above $150,000 ($300,000 joint) and how far you are from the next step.',
  },
  {
    title: 'Estimated federal tax savings',
    body: 'Translate your deduction into an estimated income tax reduction based on your marginal bracket, with a reminder that FICA still applies.',
  },
];
---

<BaseLayout
  title="NetWageTax: Free, Independent US Workplace Tax & Paycheck Calculators"
  description="Free, independent calculators for American workers. Estimate your 2026 tips and overtime deduction, understand your W-2, and see what your paycheck really means."
>
  <section class="border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
      <p class="inline-flex items-center gap-2 rounded-full bg-navy-50 dark:bg-navy-500/15 px-3 py-1 text-sm font-medium text-navy-700 dark:text-navy-300 ring-1 ring-navy-100 dark:ring-navy-500/30">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
        Updated for the 2026 tax year
      </p>
      <h1 class="mt-6 max-w-3xl text-4xl font-semibold tracking-tight text-slate-900 dark:text-slate-100 sm:text-5xl">
        Free, Independent US Workplace Tax &amp; Paycheck Calculators
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
        Clear, accurate estimates built on current IRS rules. No sign-up, no sales pitch, and nothing you enter
        leaves your browser.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/tools/obbba-tax-calculator"
          class="inline-flex items-center gap-2 rounded-lg bg-navy-700 px-5 py-3 font-medium text-white shadow-sm transition hover:bg-navy-800"
        >
          Calculate my tips &amp; overtime deduction <span aria-hidden="true">→</span>
        </a>
        <a
          href="#tools"
          class="inline-flex items-center rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-5 py-3 font-medium text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-800"
        >
          See what it covers
        </a>
      </div>

      <dl class="mt-14 grid gap-6 border-t border-slate-200 dark:border-slate-800 pt-8 sm:grid-cols-3">
        <div>
          <dt class="font-semibold text-slate-900 dark:text-slate-100">Independent</dt>
          <dd class="mt-1 text-sm text-slate-600 dark:text-slate-400">Not affiliated with the IRS, any employer, or any tax preparation company.</dd>
        </div>
        <div>
          <dt class="font-semibold text-slate-900 dark:text-slate-100">Transparent</dt>
          <dd class="mt-1 text-sm text-slate-600 dark:text-slate-400">Every result shows the math: caps, thresholds, and phase-outs.</dd>
        </div>
        <div>
          <dt class="font-semibold text-slate-900 dark:text-slate-100">Private</dt>
          <dd class="mt-1 text-sm text-slate-600 dark:text-slate-400">Calculations run on your device. We never ask for your name or SSN.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section id="tools" aria-labelledby="tools-heading" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 id="tools-heading" class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">Featured calculator</h2>
      <p class="mt-2 text-slate-600 dark:text-slate-400">Built for the new federal deductions that apply from the 2025 through 2028 tax years.</p>

      <article
        class="mt-8 overflow-hidden rounded-2xl border border-navy-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm ring-1 ring-navy-100 dark:ring-navy-500/30"
        aria-labelledby="featured-tool-title"
      >
        <div class="grid gap-10 p-6 sm:p-10 lg:grid-cols-5">
          <div class="lg:col-span-2">
            <span class="inline-block rounded-full bg-emerald-50 dark:bg-emerald-500/10 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 dark:text-emerald-400 ring-1 ring-emerald-200 dark:ring-emerald-500/30">
              New for 2026
            </span>
            <h3 id="featured-tool-title" class="mt-4 text-2xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">
              2026 OBBBA Tips &amp; Overtime Calculator
            </h3>
            <p class="mt-4 leading-relaxed text-slate-600 dark:text-slate-400">
              The One Big Beautiful Bill Act created two new federal income tax deductions: one for qualified tips and
              one for qualified overtime pay. This calculator follows the Schedule 1-A method to estimate what you can
              deduct and what it may save you.
            </p>
            <a
              href="/tools/obbba-tax-calculator"
              class="mt-8 inline-flex items-center gap-2 rounded-lg bg-navy-700 px-5 py-3 font-medium text-white shadow-sm transition hover:bg-navy-800"
            >
              Open the calculator <span aria-hidden="true">→</span>
            </a>
            <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">Free. No sign-up. Takes about two minutes.</p>
          </div>

          <ul class="grid gap-6 sm:grid-cols-2 lg:col-span-3">
            {
              features.map(({ title, body }) => (
                <li class="rounded-xl bg-slate-50 dark:bg-slate-800/40 p-5 ring-1 ring-slate-200 dark:ring-slate-800">
                  <p class="flex items-start gap-2 font-semibold text-slate-900 dark:text-slate-100">
                    <span class="text-emerald-600 dark:text-emerald-400" aria-hidden="true">✓</span>
                    {title}
                  </p>
                  <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{body}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
