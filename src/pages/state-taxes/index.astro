---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StateExplorer from '../../components/StateExplorer';
import { statePagePath, STATES } from '../../lib/state-tax-data';

const title = '2026 State Income Tax Map: Rates for All 50 States + DC';
const description =
  'Interactive map of 2026 state income tax rates. See which states have no income tax, which use a flat tax, and which are progressive, then estimate your tips and overtime deduction with state tax included.';

// Legacy deep links (/state-taxes/?state=texas or ?state=TX) move to the static state pages.
const redirects = Object.fromEntries(
  STATES.flatMap((s) => [
    [s.slug, statePagePath(s)],
    [s.code.toLowerCase(), statePagePath(s)],
  ]),
);

const counts = {
  none: STATES.filter((s) => s.structure === 'none').length,
  flat: STATES.filter((s) => s.structure === 'flat').length,
  graduated: STATES.filter((s) => s.structure === 'graduated').length,
};
---

<BaseLayout title={title} description={description} ogType="article">
  <script slot="head" is:inline define:vars={{ redirects }}>
    (() => {
      const q = new URLSearchParams(location.search).get('state');
      const to = q && redirects[q.trim().toLowerCase()];
      if (to) location.replace(to + location.hash);
    })();
  </script>
  <div class="border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-500 dark:text-slate-400">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-navy-700 dark:hover:text-navy-300">Home</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-slate-700 dark:text-slate-300">State Income Taxes</li>
        </ol>
      </nav>
      <h1 class="mt-4 max-w-3xl text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">
        2026 State Income Tax Rates by State
      </h1>
      <p class="mt-4 max-w-3xl text-lg text-slate-600 dark:text-slate-400">
        The federal tips and overtime deduction lowers only your federal income tax. Your state may still tax every
        dollar. {counts.none} states have no tax on wages, {counts.flat} use a flat rate, and {counts.graduated} (including
        DC) use progressive brackets.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <StateExplorer client:load />
  </div>
</BaseLayout>
