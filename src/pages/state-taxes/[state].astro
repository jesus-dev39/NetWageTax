---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { formatUSD } from '../../components/CurrencyInput';
import { formatLongDate } from '../../lib/site';
import {
  formatStateRate,
  relatedStates,
  statePagePath,
  STATE_TAX_DATA_AS_OF,
  STATE_TAX_LAST_UPDATED,
  STATES,
  type StateTaxInfo,
} from '../../lib/state-tax-data';
import {
  EXAMPLE_WAGE,
  exampleTax,
  leadParagraph,
  metaDescription,
  neighborRows,
  neighborSummary,
  pageTitle,
  pct,
  rankingSentences,
  STRUCTURE_NAME,
  tipsOvertimeStatus,
} from '../../lib/state-page-content';
import { INFERRED_NOTE, TIPS_OVERTIME_GUIDE_PATH, type TipsOvertimeTreatment } from '../../lib/state-tips-overtime';

// One static page per state: /state-taxes/california/, /state-taxes/new-york/, ...
export const getStaticPaths = (() => STATES.map((s) => ({ params: { state: s.slug }, props: { s } }))) satisfies GetStaticPaths;

interface Props {
  s: StateTaxInfo;
}

const { s } = Astro.props;

const title = pageTitle(s);
const description = metaDescription(s);
const tax = exampleTax(s);
const taxable = Math.max(0, EXAMPLE_WAGE - s.exemptAmount);
const neighbors = neighborRows(s);
const related = relatedStates(s.code);
const tipsStatus = tipsOvertimeStatus(s);
const tips = s.tipsOvertime;
const TIPS_HEADLINE: Record<Exclude<TipsOvertimeTreatment, 'no-wage-tax'>, string> = {
  follows: `${s.name} follows the federal tips and overtime deduction.`,
  'tips-only': `${s.name} follows the federal deduction for tips, but not for overtime.`,
  own: `${s.name} doesn’t follow the federal deduction, but it has its own break.`,
  'does-not-follow': `${s.name} does not follow the federal tips and overtime deduction.`,
  unconfirmed: `We haven’t confirmed how ${s.name} treats the federal tips and overtime deduction for 2026.`,
};
const tipsHeadline = tipsStatus === 'no-wage-tax' ? '' : TIPS_HEADLINE[tipsStatus];
const updatedLabel = formatLongDate(STATE_TAX_LAST_UPDATED);

// Both calculators preselect the state from ?state=<postal code>.
const obbbaHref = `/tools/obbba-tax-calculator/?state=${s.code}#calculator`;
const paycheckHref = `/tools/paycheck-calculator/?state=${s.code}#calculator`;

const site = Astro.site ?? new URL('https://netwagetax.com');
const abs = (path: string) => new URL(path, site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'State taxes', item: abs('/state-taxes/') },
    { '@type': 'ListItem', position: 3, name: s.name, item: abs(statePagePath(s)) },
  ],
};

const facts = [
  { label: 'Tax type', value: STRUCTURE_NAME[s.structure] },
  // "Tax type" already says there's no tax; don't repeat it as the rate.
  { label: 'Rate', value: s.structure === 'none' ? '0%' : formatStateRate(s) },
  { label: `Estimated tax on ${formatUSD(EXAMPLE_WAGE)} (single filer)`, value: formatUSD(tax) },
  { label: 'Local income taxes', value: s.localTaxLabel },
];

// Tax year the pages describe; older bracket schedules get an inflation-indexing note.
const PAGE_TAX_YEAR = 2026;
const bracketsSourceLabel = s.bracketsSource
  ? `${new URL(s.bracketsSource).hostname.replace(/^www\./, '')}${s.bracketsSource.toLowerCase().endsWith('.pdf') ? ' (PDF)' : ''}`
  : '';

const diffLabel = (d: number) => (Math.round(d) === 0 ? 'Same' : `${d > 0 ? '+' : '−'}${formatUSD(Math.abs(d))}`);
// Design tables (docs/DESIGN.md §6): surface header, 1px rows.
const th = 'bg-surface px-3 py-2 text-left font-semibold text-ink';
const td = 'border-t border-line px-3 py-2';

const revenueLink = s.sourceUrl
  ? `<a href="${s.sourceUrl}" rel="noopener" target="_blank">the official ${s.name} tax agency website</a>`
  : `the ${s.name} tax agency`;
---

<BaseLayout title={title} description={description} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <PageHeader
    title={`${s.name} state income tax 2026`}
    lead={leadParagraph(s)}
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'State taxes', href: '/state-taxes/' }, { label: s.name }]}
  >
    <p class="mt-3 text-[15px] text-ink-2">
      Last reviewed <time datetime={STATE_TAX_LAST_UPDATED}>{updatedLabel}</time>. Data: {STATE_TAX_DATA_AS_OF}.
    </p>

    <dl class="num mt-6 border-t border-line">
      {
        facts.map((f) => (
          <div class="flex flex-col gap-0.5 border-b border-line py-2.5 sm:flex-row sm:justify-between sm:gap-6">
            <dt class="text-ink-2">{f.label}</dt>
            <dd class="font-semibold text-ink sm:text-right">{f.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a href={paycheckHref} class="btn-primary inline-flex h-11 items-center justify-center rounded-control px-5 font-semibold">
        Calculate your {s.name} paycheck
      </a>
      <a
        href={obbbaHref}
        class="inline-flex h-11 items-center justify-center rounded-control border-2 border-ink bg-page px-5 font-semibold text-ink transition-colors hover:bg-surface"
      >
        Tips and overtime calculator
      </a>
    </div>
  </PageHeader>

  <div class="container-page py-10">
    <article class="prose-page max-w-3xl">
      <h2 id="how-it-works">How {s.name} taxes wages</h2>
      <p>{s.note}</p>
      {rankingSentences(s).map((t) => <p>{t}</p>)}
      {
        s.rateSource && (
          <p class="text-[15px] text-ink-2">
            Rate source:{' '}
            <a href={s.rateSource.url} rel="noopener" target="_blank">
              {s.rateSource.label}
            </a>
          </p>
        )
      }

      {
        s.structure === 'graduated' &&
          (s.brackets ? (
            <>
              <h3 id="brackets">{s.name} tax brackets for single filers</h3>
              <p class="text-[15px] text-ink-2">
                {s.bracketsYear} brackets for single filers. Source:{' '}
                <a href={s.bracketsSource} rel="noopener" target="_blank">{bracketsSourceLabel}</a>
              </p>
              {s.bracketsYear! < PAGE_TAX_YEAR && (
                <p class="text-[15px] text-ink-2">
                  {s.name} adjusts its bracket thresholds for inflation each year. The {PAGE_TAX_YEAR} thresholds haven’t
                  been published yet, so we show the latest official schedule. Rates are unchanged.
                </p>
              )}
              <div class="overflow-x-auto">
                <table class="w-full text-[15px]">
                  <thead>
                    <tr>
                      <th scope="col" class={th}>Taxable income</th>
                      <th scope="col" class={`${th} text-right`}>Rate</th>
                    </tr>
                  </thead>
                  <tbody>
                    {s.brackets.map((b, i) => {
                      const next = s.brackets![i + 1];
                      return (
                        <tr>
                          <td class={td}>{next ? `${formatUSD(b.over)} – ${formatUSD(next.over)}` : `Over ${formatUSD(b.over)}`}</td>
                          <td class={`${td} text-right`}>{pct(b.rate)}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
              {s.bracketsNote && <p class="text-[15px] text-ink-2">{s.bracketsNote}</p>}
            </>
          ) : (
            <p>
              Rates range from <strong>{pct(s.bracketRange![0])}</strong> to <strong>{pct(s.bracketRange![1])}</strong>.
              We don’t list the full bracket schedule here yet; for exact thresholds, see{' '}
              <Fragment set:html={revenueLink} />.
            </p>
          ))
      }

      <h2 id="example">Example: {formatUSD(EXAMPLE_WAGE)} salary, single filer</h2>
      {
        s.structure === 'none' ? (
          <p>
            On a {formatUSD(EXAMPLE_WAGE)} salary, {s.name} state income tax is <strong>{formatUSD(0)}</strong>. You
            still pay federal income tax and FICA (Social Security and Medicare).
          </p>
        ) : (
          <>
            <div class="overflow-x-auto">
              <table class="w-full text-[15px]">
                <caption class="sr-only">State income tax on a {formatUSD(EXAMPLE_WAGE)} salary</caption>
                <tbody>
                  <tr>
                    <th scope="row" class={`${td} text-left font-normal`}>Wages</th>
                    <td class={`${td} text-right`}>{formatUSD(EXAMPLE_WAGE)}</td>
                  </tr>
                  <tr>
                    <th scope="row" class={`${td} text-left font-normal`}>
                      Income not taxed (approx. deduction, exemptions{s.structure === 'graduated' ? ', 0% bracket' : ''})
                    </th>
                    <td class={`${td} text-right`}>−{formatUSD(s.exemptAmount)}</td>
                  </tr>
                  <tr>
                    <th scope="row" class={`${td} text-left font-normal`}>Income taxed</th>
                    <td class={`${td} text-right`}>{formatUSD(taxable)}</td>
                  </tr>
                  <tr>
                    <th scope="row" class={`${td} text-left font-normal`}>
                      {s.structure === 'flat' ? 'Flat rate' : 'Average rate used for the estimate'}
                    </th>
                    <td class={`${td} text-right`}>× {pct(s.estimateRate)}</td>
                  </tr>
                  <tr class="font-bold">
                    <th scope="row" class="border-t-2 border-ink px-3 py-2 text-left">Estimated {s.name} income tax</th>
                    <td class="border-t-2 border-ink px-3 py-2 text-right">{formatUSD(tax)}</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p>
              That works out to about {formatUSD(tax / 12)} a month, or an effective rate of {pct(tax / EXAMPLE_WAGE)} of
              wages.
            </p>
            {s.structure === 'graduated' && (
              <aside class="border-l-4 border-warning bg-warning-tint px-4 py-3 text-[15px]">
                <strong>Simplified estimate, not an exact bracket calculation.</strong> Instead of running {s.name}’s{' '}
                {pct(s.bracketRange![0])}–{pct(s.bracketRange![1])} brackets, we apply one average rate ({pct(s.estimateRate)})
                calibrated for a single filer with about {formatUSD(EXAMPLE_WAGE)} of wages. Results are close for typical
                salaries and less accurate for much higher or lower incomes, other filing statuses, or returns with state
                credits.
              </aside>
            )}
          </>
        )
      }

      <h2 id="tips-overtime">Does {s.name} tax tips and overtime?</h2>
      {
        tipsStatus === 'no-wage-tax' ? (
          <p>
            {s.name} doesn’t tax wages, so tips and overtime aren’t subject to state income tax either. The federal
            deduction for qualified tips and overtime (Schedule 1-A) still lowers your federal income tax.
          </p>
        ) : (
          <>
            <p>
              <strong>{tipsHeadline}</strong> {tips.detail}
            </p>
            {tipsStatus === 'does-not-follow' && (
              <p>
                Qualified tips and overtime you deduct on your federal return (Schedule 1-A) are still taxed by {s.name},
                and our estimate taxes your full wages.
              </p>
            )}
            {(tipsStatus === 'follows' || tipsStatus === 'tips-only' || tipsStatus === 'own') && (
              <p>
                Our estimate doesn’t subtract {tipsStatus === 'own' ? `${s.name}’s own break` : 'the deduction'} yet: it
                applies the state tax to your full wages, so it can overstate your {s.name} tax if you have qualifying{' '}
                {tipsStatus === 'tips-only' ? 'tips' : 'tips or overtime'}.
              </p>
            )}
            {tipsStatus === 'unconfirmed' && (
              <p>
                Check with <Fragment set:html={revenueLink} /> before you file. Our estimate applies the state tax to your
                full wages.
              </p>
            )}
          </>
        )
      }
      <p class="text-[15px] text-ink-2">
        {tips.inferred && <>{INFERRED_NOTE} </>}
        {tips.sources.length > 0 && 'Source: '}
        {
          tips.sources.map((src, i) => (
            <>
              {i > 0 && '; '}
              <a href={src.url} rel="noopener" target="_blank">{src.label}</a>
              {src.date && `, ${src.date}`}
            </>
          ))
        }
        {tips.sources.length > 0 && '. '}
        Checked <time datetime={tips.checked}>{formatLongDate(tips.checked)}</time>.{' '}
        <a href={TIPS_OVERTIME_GUIDE_PATH}>See how every state treats tips and overtime</a>
      </p>
      {
        tipsStatus !== 'no-wage-tax' && (
          <p>
            To see your federal deduction and {s.name} tax together, open the{' '}
            <a href={obbbaHref}>tips and overtime calculator with {s.name} selected</a>.
          </p>
        )
      }

      {
        s.localTaxNote && (
          <>
            <h2 id="local-taxes">Local income taxes in {s.name}</h2>
            <p>{s.localTaxNote}</p>
            <p>These local taxes are not included in the estimate above.</p>
          </>
        )
      }

      <h2 id="neighbors">{s.name} vs. neighboring states</h2>
      <p>{neighborSummary(s)}</p>
      {
        neighbors.length > 0 && (
          <div class="overflow-x-auto">
            <table class="w-full text-[15px]">
              <thead>
                <tr>
                  <th scope="col" class={th}>State</th>
                  <th scope="col" class={`${th} hidden sm:table-cell`}>Rate</th>
                  <th scope="col" class={`${th} text-right`}>Est. tax on {formatUSD(EXAMPLE_WAGE)}</th>
                  <th scope="col" class={`${th} text-right`}>vs. {s.name}</th>
                </tr>
              </thead>
              <tbody>
                {neighbors.map((n) => (
                  <tr>
                    <td class={td}>
                      <a href={statePagePath(n.state)}>{n.state.name}</a>
                    </td>
                    <td class={`${td} hidden sm:table-cell`}>{formatStateRate(n.state)}</td>
                    <td class={`${td} text-right`}>{formatUSD(n.tax)}</td>
                    <td class={`${td} text-right`}>{diffLabel(n.diff)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }

      <h2 id="source">Official source</h2>
      {
        s.sourceUrl ? (
          <p>
            For forms, exact brackets, and filing deadlines, go to <Fragment set:html={revenueLink} />.
          </p>
        ) : (
          <p>For forms, exact brackets, and filing deadlines, check the {s.name} tax agency.</p>
        )
      }

      <h2 id="related">Related states</h2>
      <ul class="!list-none !pl-0">
        {
          related.map((r) => (
            <li class="!mt-0 flex flex-wrap justify-between gap-x-4 border-b border-line py-2.5 first:border-t">
              <a href={statePagePath(r)}>{r.name}</a>
              <span class="num text-ink-2">{formatStateRate(r)}</span>
            </li>
          ))
        }
      </ul>
      <p>
        <a href="/state-taxes/">All states and DC on the map</a>
      </p>
    </article>

    <p class="mt-10 max-w-3xl text-sm text-ink-2">
      Estimates cover {s.name} income tax on wages for a single filer and exclude local taxes and state credits. They are
      not tax advice. See our <a href="/disclaimer/" class="text-link underline underline-offset-[3px]">disclaimer</a> and{' '}
      <a href="/methodology/" class="text-link underline underline-offset-[3px]">how we calculate</a>.
    </p>
  </div>
</BaseLayout>
