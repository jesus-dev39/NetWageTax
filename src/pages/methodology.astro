---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { formatUSD } from '../components/CurrencyInput';
import {
  ADDITIONAL_MEDICARE_RATE,
  ADDITIONAL_MEDICARE_THRESHOLD,
  MEDICARE_RATE,
  SOCIAL_SECURITY_RATE,
  SOCIAL_SECURITY_WAGE_BASE_2026,
} from '../lib/fica';
import { ADDITIONAL_STANDARD_DEDUCTION_AGED_2026, STANDARD_DEDUCTION_2026, TAX_BRACKETS_2026 } from '../lib/marginal-rate';
import { CAR_LOAN_PARAMS_BY_YEAR, PARAMS_BY_YEAR, SENIOR_PARAMS_BY_YEAR } from '../lib/obbba-params';
import { OVERTIME_MULTIPLIER } from '../lib/paycheck';
import { formatLongDate, SITE_TAX_YEAR } from '../lib/site';
import {
  BRACKET_ENGINE_STATES,
  GRADUATED_REFERENCE_WAGE,
  STATE_TAX_DATA_AS_OF,
  STATE_TAX_LAST_UPDATED,
  statePagePath,
} from '../lib/state-tax-data';

// Every figure on this page comes from the constants the calculators use.
const pct = (r: number) => `${+(r * 100).toFixed(2)}%`;
const rates = TAX_BRACKETS_2026.single.map((b) => b.rate);
const bracketRange = `${pct(Math.min(...rates))} to ${pct(Math.max(...rates))}`;
const obbba = PARAMS_BY_YEAR[SITE_TAX_YEAR];
const senior = SENIOR_PARAMS_BY_YEAR[SITE_TAX_YEAR];
const carLoan = CAR_LOAN_PARAMS_BY_YEAR[SITE_TAX_YEAR];
const carLoanStep = carLoan.phaseout.kind === 'step' ? carLoan.phaseout : null;
const seniorRate = senior.phaseout.kind === 'rate' ? senior.phaseout.rate : 0;

const summary: { label: string; value: string; note?: string }[] = [
  { label: 'Tax year', value: String(SITE_TAX_YEAR) },
  { label: 'Rules last checked', value: formatLongDate(STATE_TAX_LAST_UPDATED) },
  {
    label: 'State data',
    value: STATE_TAX_DATA_AS_OF,
    note: 'Some bracket tables show the latest year the state has published.',
  },
];
---

<BaseLayout
  title="How We Calculate"
  description="The sources, assumptions, and limits behind NetWageTax's paycheck, tips and overtime, and state income tax estimates, and how to report an error."
  ogType="article"
>
  <PageHeader
    title="How we calculate"
    lead="Where our numbers come from, what they assume, and why they can differ from your actual paycheck or tax bill."
  >
    <dl class="mt-8 border-t border-line text-[15px] sm:text-base">
      {
        summary.map(({ label, value, note }) => (
          <div class="flex flex-col gap-0.5 border-b border-line py-2.5 sm:flex-row sm:justify-between sm:gap-6">
            <dt class="shrink-0 text-ink-2">{label}</dt>
            <dd class="text-ink sm:text-right">
              <span class="font-semibold">{value}</span>
              {note && <span class="mt-0.5 block text-sm text-ink-2">{note}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </PageHeader>

  <div class="container-page py-10">
  <article class="prose-page max-w-3xl">
    <h2 id="sources">Sources</h2>
    <ul>
      <li>
        <strong>Federal income tax.</strong> The {SITE_TAX_YEAR} brackets ({bracketRange}) and standard deduction
        ({formatUSD(STANDARD_DEDUCTION_2026.single)} single, {formatUSD(STANDARD_DEDUCTION_2026.mfj)} married filing
        jointly, {formatUSD(STANDARD_DEDUCTION_2026.hoh)} head of household) come from the IRS inflation adjustments
        in Revenue Procedure 2025-32.
      </li>
      <li>
        <strong>Social Security and Medicare.</strong> Social Security is {pct(SOCIAL_SECURITY_RATE)} of wages up to
        the {SITE_TAX_YEAR} wage base of {formatUSD(SOCIAL_SECURITY_WAGE_BASE_2026)}, published by the Social
        Security Administration. Medicare is {pct(MEDICARE_RATE)} of all wages, plus an additional{' '}
        {pct(ADDITIONAL_MEDICARE_RATE)} on wages above {formatUSD(ADDITIONAL_MEDICARE_THRESHOLD.single)}{' '}
        ({formatUSD(ADDITIONAL_MEDICARE_THRESHOLD.mfj)} married filing jointly).
      </li>
      <li>
        <strong>Schedule 1-A deductions.</strong> The One Big Beautiful Bill Act (Public Law 119-21), the Internal
        Revenue Code sections it added, and the IRS Schedule 1-A and its instructions. The tips and overtime deduction
        (sections 224 and 225) is capped at {formatUSD(obbba.tips.capSingleOrHoh)} for qualified tips and {formatUSD(obbba.overtime.capSingleOrHoh)}{' '}
        for qualified overtime ({formatUSD(obbba.overtime.capMfj)} married filing jointly), and phases out above{' '}
        {formatUSD(obbba.tips.phaseoutThresholdSingleOrHoh)} of modified AGI ({formatUSD(obbba.tips.phaseoutThresholdMfj)}{' '}
        married filing jointly). The enhanced deduction for seniors (section 151(d)(5)(C)) is{' '}
        {formatUSD(senior.amountPerPerson)} for each person 65 or older, reduced by {pct(seniorRate)} of modified AGI
        above {formatUSD(senior.thresholdSingleOrHoh)} ({formatUSD(senior.thresholdMfj)} married filing jointly). The
        car loan interest deduction (section 163(h)(4)) is capped at {formatUSD(carLoan.capPerReturn)} per return and
        reduced by {formatUSD(carLoanStep?.perStep ?? 0)} for each {formatUSD(carLoanStep?.stepSize ?? 0)}, or part of it,
        of modified AGI above {formatUSD(carLoan.thresholdOther)} ({formatUSD(carLoan.thresholdMfj)} married filing
        jointly), following the Treasury's final regulations (TD 10054). The senior and car loan interest calculators
        follow the {SITE_TAX_YEAR} draft Schedule 1-A until the IRS publishes the final form and instructions.
      </li>
      <li>
        <strong>State income tax.</strong> Each state's tax agency. Every <a href="/state-taxes/">state page</a> links
        to its official source, and bracket tables name the document they were copied from. How each state treats the
        tips and overtime deduction, with its source, is in our guide to{' '}
        <a href="/guides/which-states-tax-tips-and-overtime/">which states tax tips and overtime</a>.
      </li>
    </ul>

    <h2 id="exact-vs-estimated">What's calculated exactly and what's estimated</h2>
    <p>
      <strong>Calculated from the published rules:</strong> federal income tax on your taxable income, Social Security,
      Medicare (including the additional Medicare tax), and the Schedule 1-A deductions with their caps and
      phase-outs. For the inputs you enter, these follow the law step by step.
    </p>
    <p>
      <strong>State income tax</strong> is calculated in one of two ways, depending on the state. Neither is a full
      state tax return:
    </p>
    <ul>
      <li>States with no wage tax are $0.</li>
      <li>
        <strong>Full bracket calculation:</strong>{' '}
        {
          BRACKET_ENGINE_STATES.map((s, i) => (
            <>
              {i > 0 && (i === BRACKET_ENGINE_STATES.length - 1 ? ', and ' : ', ')}
              <a href={statePagePath(s)}>{s.name}</a>
            </>
          ))
        }. We subtract the state's own deduction or exemption (in South Carolina, a deduction that shrinks as income
        rises), run every bracket on the rest, add special surcharges such as California's 1% tax on taxable
        income over $1 million, and subtract personal credits such as California's personal exemption credit. Each
        state page shows the calculation bracket by bracket.
      </li>
      <li>
        <strong>Simplified estimate</strong>, for the other states that tax wages. Flat-rate states apply their rate to
        wages above an approximate single-filer deduction or exemption. The other states with progressive brackets
        use one average rate, calibrated for a single filer earning about {formatUSD(GRADUATED_REFERENCE_WAGE)},
        instead of running every bracket. Results are close for typical salaries and less accurate for much higher or
        lower incomes.
      </li>
      <li>
        Both use single-filer figures whatever filing status you choose: we don't have the brackets for married or
        head-of-household filers yet. Neither includes other state tax credits or local income taxes. In the tips and overtime
        calculator, both first subtract what your state allows for tips and overtime: the final federal deduction in
        states that follow it, the tips part only in states that follow it for tips only, and the state's own capped
        amounts in Georgia and Alabama. The paycheck calculator and the state pages tax full wages. Each state's
        treatment is listed in our guide to <a href="/guides/which-states-tax-tips-and-overtime/">which states tax tips
        and overtime</a>.
      </li>
    </ul>
    <p>
      Paychecks can also differ from our figures because employers withhold using IRS Publication 15-T and your
      Form W-4, while we estimate the tax you owe for the full year.
    </p>

    <h2 id="assumptions">What the estimates assume</h2>
    <ul>
      <li>You take the standard deduction rather than itemizing.</li>
      <li>
        No pre-tax deductions: no 401(k) or 403(b) contributions, health insurance premiums, or HSA contributions.
      </li>
      <li>No Form W-4 adjustments for dependents, other income, or extra withholding.</li>
      <li>No federal or state tax credits, except the personal credits of the states calculated bracket by bracket.</li>
      <li>No local income taxes from cities, counties, or school districts.</li>
      <li>
        In the paycheck calculator: 52 weeks of pay a year, overtime paid at {OVERTIME_MULTIPLIER}× your hourly rate,
        and no tips and overtime deduction (use the <a href="/tools/obbba-tax-calculator/">tips and overtime
        calculator</a> for that).
      </li>
      <li>
        In the <a href="/tools/senior-deduction-calculator/">senior deduction calculator</a>: the standard deduction
        plus the additional amount for age 65 ({formatUSD(ADDITIONAL_STANDARD_DEDUCTION_AGED_2026.unmarried)} unmarried,{' '}
        {formatUSD(ADDITIONAL_STANDARD_DEDUCTION_AGED_2026.married)} for each spouse 65 or older), and income that may
        not be wages, so no Social Security or Medicare.
      </li>
    </ul>

    <h2 id="review">How often we review the data</h2>
    <p>
      We update federal and FICA figures when the IRS and the Social Security Administration publish the next year's
      numbers, usually in October and November. We review the state data every January and whenever a state changes
      its law during the year. The date in the strip at the top of every page shows the last review.
    </p>

    <h2 id="report-an-error">Report an error</h2>
    <p>
      If a number looks wrong, <a href="/contact/">contact us</a> with the page, the values you entered, and what you
      expected to see. We check every report against the official source and fix confirmed errors.
    </p>
    <p>
      NetWageTax gives estimates for educational purposes, not tax advice. See our <a href="/disclaimer/">disclaimer</a>.
    </p>
  </article>
  </div>
</BaseLayout>
