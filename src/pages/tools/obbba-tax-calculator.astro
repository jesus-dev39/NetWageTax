---
import BaseLayout from '../../layouts/BaseLayout.astro';
import W2Decoder from '../../components/W2Decoder';
import TaxCalculatorApp from '../../components/TaxCalculatorApp';
import AdSlot from '../../components/AdSlot';
import FaqList from '../../components/FaqList.astro';
import PageHeader from '../../components/PageHeader.astro';
import RelatedDeductions from '../../components/RelatedDeductions.astro';
import { TIPS_OVERTIME_GUIDE_PATH } from '../../lib/state-tips-overtime';

const title = '2026 No Tax on Tips & Overtime Calculator (OBBBA)';
const description =
  'Estimate your 2026 federal deduction for qualified tips and overtime under the One Big Beautiful Bill Act. Decode W-2 Box 12 Codes TA, TP, and TT and see how the MAGI phase-out affects you.';

// Answers are plain text so they can be reused verbatim in FAQPage structured data.
const faqs = [
  {
    question: 'What is the OBBBA Tips and Overtime deduction?',
    answer: [
      'The One Big Beautiful Bill Act (OBBBA), signed into law on July 4, 2025, created two new federal income tax deductions for tax years 2025 through 2028: one for qualified tips (IRC §224) and one for qualified overtime compensation.',
      'You can deduct up to $25,000 of qualified tips per return, and up to $12,500 of qualified overtime premium pay ($25,000 if married filing jointly). Both deductions are claimed on Schedule 1-A and are available whether you take the standard deduction or itemize. They reduce your taxable income, not your adjusted gross income.',
      'To qualify, you need a valid Social Security number, and married couples must file jointly. Tips must be earned in an occupation on the Treasury Department’s list of jobs that customarily received tips, and overtime must be required under the Fair Labor Standards Act (FLSA).',
    ],
  },
  {
    question: 'What do Codes TA, TP, and TT mean on my W-2 Box 12?',
    answer: [
      'Code TA reports your employer’s contributions to a Trump Account for your child. It is informational only and does not affect the tips or overtime deduction.',
      'Code TP reports the total qualified tips your employer identified as eligible for the “no tax on tips” deduction. Use this amount as the starting point for the tips portion of Schedule 1-A.',
      'Code TT reports your qualified overtime compensation: only the premium portion of your overtime pay (the extra “half” in time-and-a-half), not your total overtime earnings. Use this amount as the starting point for the overtime portion of Schedule 1-A.',
      'Your employer does not apply the deduction caps or the income phase-out. You calculate those when you file.',
    ],
  },
  {
    question: 'Does this deduction eliminate payroll (FICA) taxes?',
    answer: [
      'No. The OBBBA tips and overtime deductions only reduce your federal income tax. Social Security and Medicare taxes (FICA) still apply to 100% of your reported tips and overtime, and your employer will continue to withhold them from your paycheck.',
      'State income tax treatment varies. A few states follow the federal deduction, some follow it for tips only or have their own smaller break, and most tax tips and overtime in full, so check your state’s rules separately.',
    ],
    link: { href: TIPS_OVERTIME_GUIDE_PATH, label: 'See which states tax tips and overtime in 2026' },
  },
  {
    question: 'What is the MAGI income phase-out limit for 2026?',
    answer: [
      'For 2026, both deductions begin to phase out when your modified adjusted gross income (MAGI) exceeds $150,000 for single and head of household filers, or $300,000 for married couples filing jointly.',
      'For every full $1,000 of MAGI above the threshold, your deduction is reduced by $100. The qualified tips deduction is fully phased out at $400,000 of MAGI for single and head of household filers, and $550,000 for joint filers. The qualified overtime deduction is fully phased out at $275,000 for single and head of household filers, and $550,000 for joint filers.',
      'For most taxpayers, MAGI is the same as the adjusted gross income (AGI) on your Form 1040. It can be higher if you exclude foreign earned income or income from U.S. territories.',
    ],
  },
  {
    question: 'What other deductions are on Schedule 1-A?',
    answer: [
      'Schedule 1-A also has two other deductions. The enhanced deduction for seniors is up to $6,000 for each person 65 or older, reduced once MAGI passes $75,000 ($150,000 if married filing jointly). The car loan interest deduction is up to $10,000 of interest on a loan taken out after 2024 for a new vehicle assembled in the United States, reduced once MAGI passes $100,000 ($200,000 if married filing jointly). We have a separate calculator for each.',
      'The deductions on Schedule 1-A add up to one total that reduces your taxable income, whether you take the standard deduction or itemize.',
    ],
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ question, answer }) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer.join(' ') },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://netwagetax.com/' },
        { '@type': 'ListItem', position: 2, name: 'Tips and overtime calculator', item: 'https://netwagetax.com/tools/obbba-tax-calculator/' },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <PageHeader
    title="2026 no tax on tips and overtime calculator"
    lead="See how much of your tips and overtime you may be able to deduct from your federal taxable income under the One Big Beautiful Bill Act (OBBBA), including the caps and the income phase-out."
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Tips and overtime calculator' }]}
  />

  <div class="container-page flex flex-col gap-12 py-10">
    <!--
      Ad placement 1: below the page title, above the W-2 decoder. Add slotId="…" from the AdSense dashboard to go live.
      md+ only: on phones the reserved 100px pushed the first input below a 700px screen. While hidden,
      client:visible never hydrates it, so no ad request is made.
    -->
    <div class="hidden md:block">
      <AdSlot client:visible format="leaderboard" placement="calculator-top" />
    </div>
    <W2Decoder client:load />
    <div class="border-t border-line pt-10">
      <TaxCalculatorApp client:load />
    </div>
    <RelatedDeductions current="/tools/obbba-tax-calculator/" />
  </div>

  <section aria-labelledby="faq-heading" class="border-t border-line">
    <div class="container-page py-12">
      <div class="max-w-3xl">
        <h2 id="faq-heading" class="text-2xl/[1.2] font-bold tracking-[-0.01em] text-ink md:text-[1.75rem]">Frequently asked questions</h2>
        <div class="mt-5">
          <FaqList faqs={faqs} />
        </div>
        <!-- Ad placement: after the FAQ list, before the disclaimer; well away from the export/download buttons. -->
        <AdSlot client:visible format="leaderboard" placement="calculator-bottom" className="mt-10" />
        <p class="mt-8 text-[15px] text-ink-2">
          This calculator provides educational estimates and is not tax advice. Results are not a tax return. Verify your
          figures with the official IRS Schedule 1-A instructions or a CPA or enrolled agent.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
