---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot';
import PaycheckCalculatorApp from '../../components/PaycheckCalculatorApp';

const title = '2026 Hourly & Salary Paycheck Calculator: Take-Home Pay After Taxes';
const description =
  'Free 2026 paycheck calculator for hourly and salaried workers. See your take-home pay per paycheck after federal income tax, Social Security, Medicare, and state tax, with overtime at 1.5× and all 50 states.';

// Plain-text answers so they can be reused verbatim in FAQPage structured data.
const faqs = [
  {
    question: 'How is take-home pay calculated?',
    answer: [
      'Take-home pay is your gross pay minus federal income tax, Social Security, Medicare, and any state income tax. This calculator annualizes your pay (hourly rate × hours × 52 weeks, plus overtime at 1.5×), estimates each tax for the full year, and divides by the number of paychecks.',
      'Federal income tax uses the 2026 standard deduction ($16,100 single, $32,200 married filing jointly, $24,150 head of household) and the 2026 brackets from 10% to 37%. Only the income in each bracket is taxed at that bracket’s rate, so your effective rate is always lower than your top bracket.',
    ],
  },
  {
    question: 'What are the 2026 Social Security and Medicare rates?',
    answer: [
      'Employees pay 6.2% Social Security tax on wages up to the 2026 wage base of $184,500, and 1.45% Medicare tax on all wages. Your employer pays a matching amount.',
      'An additional 0.9% Medicare tax applies to wages above $200,000 for single and head of household filers ($250,000 for married filing jointly). Employers start withholding it once your wages pass $200,000, regardless of filing status, and any difference is settled on your tax return.',
    ],
  },
  {
    question: 'What is the difference between bi-weekly and semi-monthly pay?',
    answer: [
      'Bi-weekly pay comes every other week, for 26 paychecks a year. Semi-monthly pay comes twice a month, usually on the 15th and last day, for 24 paychecks a year.',
      'Your annual pay is the same either way, but each bi-weekly paycheck is smaller, and two months of the year include a third paycheck.',
    ],
  },
  {
    question: 'How is overtime taxed?',
    answer: [
      'Overtime is taxed like regular wages: federal income tax, Social Security, Medicare, and state tax all apply. Under the Fair Labor Standards Act, non-exempt employees earn at least 1.5 times their regular rate for hours over 40 in a workweek.',
      'For tax years 2025 through 2028, the One Big Beautiful Bill Act lets eligible workers deduct the premium portion of qualified overtime (the extra “half”) on their federal return, up to $12,500 ($25,000 if married filing jointly). Your paycheck withholding doesn’t reflect that deduction automatically unless you adjust your Form W-4. Use our tips and overtime calculator to estimate it.',
    ],
  },
  {
    question: 'Why might my actual paycheck be different?',
    answer: [
      'Real paychecks usually include pre-tax deductions such as 401(k) contributions, health insurance premiums, and HSA contributions, which lower your taxable wages. Your Form W-4 choices (dependents, other income, extra withholding) also change federal withholding.',
      'Bonuses are often withheld at a flat 22% federal rate, some cities and counties add local income taxes, and a few states charge disability insurance on wages. Treat this calculator as an estimate and compare it with your pay stub.',
    ],
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ question, answer }) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer.join(' ') },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://netwagetax.com/' },
        { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://netwagetax.com/#calculators' },
        { '@type': 'ListItem', position: 3, name: 'Paycheck Calculator', item: 'https://netwagetax.com/tools/paycheck-calculator/' },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-500 dark:text-slate-400">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="hover:text-navy-700 dark:hover:text-navy-300">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/#calculators" class="hover:text-navy-700 dark:hover:text-navy-300">Tools</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-slate-700 dark:text-slate-300">Paycheck Calculator</li>
        </ol>
      </nav>
      <h1 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">
        2026 Hourly &amp; Salary Paycheck Calculator
      </h1>
      <p class="mt-4 max-w-3xl text-lg text-slate-600 dark:text-slate-400">
        See what actually lands in your bank account each payday, after federal income tax, Social Security, Medicare,
        and state tax, for hourly or salaried pay.
      </p>
      <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-600 dark:text-slate-400">
        <li class="flex items-center gap-2"><span class="text-emerald-600 dark:text-emerald-400" aria-hidden="true">✓</span> 2026 federal brackets &amp; FICA wage base</li>
        <li class="flex items-center gap-2"><span class="text-emerald-600 dark:text-emerald-400" aria-hidden="true">✓</span> Overtime at 1.5× included</li>
        <li class="flex items-center gap-2"><span class="text-emerald-600 dark:text-emerald-400" aria-hidden="true">✓</span> All 50 states + DC</li>
      </ul>
    </div>
  </div>

  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-10 sm:px-6">
    <!--
      Ad placement: below the page title. Add slotId="…" from the AdSense dashboard to go live.
      md+ only: on phones the reserved 100px pushed the first input below a 700px screen. While hidden,
      client:visible never hydrates it, so no ad request is made.
    -->
    <div class="hidden md:block">
      <AdSlot client:visible format="leaderboard" placement="paycheck-top" />
    </div>
    <PaycheckCalculatorApp client:load />
  </div>

  <section aria-labelledby="faq-heading" class="border-t border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
    <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
      <h2 id="faq-heading" class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">Frequently asked questions</h2>
      <div class="mt-6 divide-y divide-slate-200 border-y border-slate-200 dark:divide-slate-800 dark:border-slate-800">
        {
          faqs.map(({ question, answer }, i) => (
            <details class="group py-5" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-slate-900 dark:text-slate-100 [&::-webkit-details-marker]:hidden">
                <h3 class="text-lg">{question}</h3>
                <span class="shrink-0 text-xl text-slate-400 transition group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <div class="mt-3 space-y-3 leading-relaxed text-slate-600 dark:text-slate-400">
                {answer.map((p) => <p>{p}</p>)}
              </div>
            </details>
          ))
        }
      </div>
      <!-- Ad placement: after the FAQ list, before the disclaimer; well away from the export/download buttons. -->
      <AdSlot client:visible format="leaderboard" placement="paycheck-bottom" className="mt-10" />
      <p class="mt-8 text-sm text-slate-500 dark:text-slate-400">
        This calculator provides educational estimates, not tax or payroll advice. For your exact withholding, see IRS
        Publication 15-T and your employer’s payroll department. Have tips or overtime?{' '}
        <a href="/tools/obbba-tax-calculator/" class="font-medium text-emerald-700 underline underline-offset-2 dark:text-emerald-400">Estimate your 2026 tips &amp; overtime deduction</a>.
      </p>
    </div>
  </section>
</BaseLayout>
