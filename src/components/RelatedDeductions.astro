---
/**
 * "Other Schedule 1-A deductions": links to the other Schedule 1-A calculators, shown between a
 * calculator and its FAQ (never next to buttons or ads).
 */
import { SCHEDULE_1A_TOOLS } from '../lib/schedule-1a-tools';

interface Props {
  /** Path of the current page, left out of the list. */
  current: string;
}

const others = SCHEDULE_1A_TOOLS.filter((t) => t.href !== Astro.props.current);
---

<section aria-labelledby="related-heading" class="border-t border-line pt-8">
  <h2 id="related-heading" class="text-xl/[1.3] font-bold text-ink">Other Schedule 1-A deductions</h2>
  <ul class="mt-3 grid border-t border-line md:grid-cols-2 md:gap-x-8">
    {
      others.map(({ href, title, body }) => (
        <li class="border-b border-line py-4">
          <a href={href} class="text-[19px] font-semibold text-link underline underline-offset-[3px] hover:decoration-2">
            {title}
          </a>
          <p class="mt-1 text-ink-2">{body}</p>
        </li>
      ))
    }
  </ul>
</section>
