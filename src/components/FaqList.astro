---
/**
 * Frequently asked questions as native <details>, separated by 1px rules. The page builds the
 * matching FAQPage structured data from the same array.
 */
interface Props {
  /** `link` is shown after the answer only; it isn't part of the structured data text. */
  faqs: { question: string; answer: string[]; link?: { href: string; label: string } }[];
  /** Open the first answer by default. */
  openFirst?: boolean;
}

const { faqs, openFirst = true } = Astro.props;
---

<div class="border-t border-line">
  {
    faqs.map(({ question, answer, link }, i) => (
      <details class="group border-b border-line" open={openFirst && i === 0}>
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-4 [&::-webkit-details-marker]:hidden">
          <h3 class="text-lg/[1.4] font-semibold text-ink">{question}</h3>
          <span aria-hidden="true" class="w-4 shrink-0 text-center text-xl/[1.4] font-semibold text-ink">
            <span class="group-open:hidden">+</span>
            <span class="hidden group-open:inline">−</span>
          </span>
        </summary>
        <div class="space-y-3 pb-5 text-ink-2">
          {answer.map((p) => (
            <p>{p}</p>
          ))}
          {link && (
            <p>
              <a href={link.href} class="text-link underline underline-offset-[3px] hover:decoration-2">
                {link.label}
              </a>
            </p>
          )}
        </div>
      </details>
    ))
  }
</div>
